[Unit]
Description=OSIRIS Worker ARQ (téléchargements ISO)
After=network.target redis.service
Wants=redis.service

[Service]
# Compte de service sans shell ni sudo : voir README, « En production : un compte
# de service dédié ». Jamais le compte d'un administrateur.
User=osiris
Group=osiris
WorkingDirectory=/opt/osiris/backend
Environment=PATH=/opt/osiris/backend/venv/bin
ExecStart=/opt/osiris/backend/venv/bin/arq worker.WorkerSettings
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
