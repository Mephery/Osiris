#Requires -RunAsAdministrator
<#
    OSIRIS - Premier demarrage Windows - {{ machine.hostname }}
    Genere a la volee par OSIRIS, telecharge pendant le deploiement WinPE.
#>

$ErrorActionPreference = "Continue"
$logFile = "C:\osiris-firstboot.log"
$osirisUrl = "{{ osiris_url }}"
$script:_mac = $null  # sera defini apres detection reseau

# En cas d'erreur fatale non capturee, signaler l'echec a OSIRIS
trap {
    $errMsg = $_.Exception.Message -replace '"', "'"
    Write-Host "$(Get-Date -Format 'HH:mm:ss') ERREUR FATALE : $errMsg"
    Add-Content -Path $logFile -Value "$(Get-Date -Format 'HH:mm:ss') ERREUR FATALE : $errMsg" -EA SilentlyContinue
    if ($script:_mac) {
        try {
            Invoke-WebRequest -Uri "$osirisUrl/machines/$($script:_mac)/status?status=failed" `
                -Method POST -UseBasicParsing -TimeoutSec 10 | Out-Null
        } catch {}
    }
    continue
}

function Write-Log($msg) {
    $line = "$(Get-Date -Format 'HH:mm:ss') $msg"
    Write-Host $line
    Add-Content -Path $logFile -Value $line
    # Remonte aussi dans OSIRIS (vue live du deploiement, comme la phase WinPE) pour
    # qu'un operateur voie la progression du firstboot au lieu d'un ecran fige.
    # Fire-and-forget : jamais bloquant, echecs ignores. Actif des que la MAC est connue.
    if ($script:_mac) {
        try {
            $enc = [uri]::EscapeDataString($msg)
            Invoke-WebRequest -Uri "$osirisUrl/machines/$($script:_mac)/log?msg=$enc" `
                -Method POST -UseBasicParsing -TimeoutSec 5 -ErrorAction SilentlyContinue | Out-Null
        } catch {}
    }
}

# Ecrit le detail dans le fichier de log seulement (pas la console) - utilise pour
# la sortie verbeuse de winget, qui pollue sinon la console avec son propre spinner.
function Write-LogFile($msg) {
    Add-Content -Path $logFile -Value "$(Get-Date -Format 'HH:mm:ss') $msg"
}

Write-Log "=========================================="
Write-Log "OSIRIS First Boot - {{ machine.hostname }}"
{% if profile.machine_type == 'server' %}
Write-Log "Type : Windows Server (deploiement serveur)"
{% endif %}
Write-Log "=========================================="

# ── Attendre que le reseau soit disponible ───────────────────────────────────
Write-Log "Attente de la connectivite reseau..."
$retries = 0
while ($retries -lt 30) {
    try {
        $null = Invoke-WebRequest -Uri "$osirisUrl/boot" -UseBasicParsing -TimeoutSec 3 -ErrorAction Stop
        break
    } catch {
        Start-Sleep -Seconds 5
        $retries++
    }
}

# ── Adresse MAC : identite CANONIQUE de la machine ───────────────────────────
# On prend la MAC gravee au rendu du script cote serveur, et NON celle detectee en
# live : avec un adaptateur USB-Ethernet, Windows voit la MAC du DONGLE, qui n'est
# PAS l'identite de la machine (elle est stockee a part dans `deploy_mac` et OUBLIEE
# en fin de deploiement pour que le dongle serve ailleurs). Poster sur
# /machines/<MAC-du-dongle>/... renverrait 404 des que le dongle est libere.
# La MAC live reste affichee dans le log, utile au diagnostic.
$mac = '{{ machine.mac }}'
$script:_mac = $mac
$adapterLive = Get-NetAdapter | Where-Object { $_.Status -eq "Up" -and $_.HardwareInterface } | Select-Object -First 1
if ($adapterLive) {
    $macLive = $adapterLive.MacAddress -replace '-', '' | ForEach-Object { $_.ToLower() }
    if ($macLive -ne $mac) {
        Write-Log "MAC machine : $mac (adaptateur actif : $macLive)"
    } else {
        Write-Log "MAC machine : $mac"
    }
} else {
    Write-Log "AVERTISSEMENT : aucun adaptateur reseau actif (MAC machine : $mac)"
}

# ── Inventaire materiel ───────────────────────────────────────────────────────
Write-Log "Collecte des informations materiel..."
try {
    $cs   = Get-CimInstance -ClassName Win32_ComputerSystem -ErrorAction Stop
    $bios = Get-CimInstance -ClassName Win32_BIOS           -ErrorAction Stop
    # Certaines VM (Proxmox/OVMF) renvoient un SerialNumber/Manufacturer/Model vide (null) -
    # .Trim() sur null plante le script, donc on retombe sur une chaine vide dans ce cas.
    $hwSerial     = if ($bios.SerialNumber) { $bios.SerialNumber.Trim() } else { '' }
    $hwManufact   = if ($cs.Manufacturer)   { $cs.Manufacturer.Trim()   } else { '' }
    $hwModelName  = if ($cs.Model)          { $cs.Model.Trim()         } else { '' }
    $hwModel  = "$hwManufact $hwModelName".Trim()
    $hwRamGb  = [math]::Round($cs.TotalPhysicalMemory / 1GB)
    # CPU (type/modele) et taille du disque systeme (disque physique portant C:).
    $cpu = Get-CimInstance -ClassName Win32_Processor -ErrorAction SilentlyContinue | Select-Object -First 1
    $hwCpu = if ($cpu -and $cpu.Name) { $cpu.Name.Trim() } else { '' }
    $diskNum = (Get-Partition -DriveLetter C -ErrorAction SilentlyContinue).DiskNumber
    $disk = if ($null -ne $diskNum) {
        Get-CimInstance Win32_DiskDrive -EA SilentlyContinue | Where-Object { $_.Index -eq $diskNum } | Select-Object -First 1
    } else {
        Get-CimInstance Win32_DiskDrive -EA SilentlyContinue | Sort-Object Index | Select-Object -First 1
    }
    $hwDiskGb = if ($disk -and $disk.Size) { [math]::Round($disk.Size / 1GB) } else { 0 }
    # Type de disque (SSD/HDD + bus NVMe/SATA) via Get-PhysicalDisk (dispo en Windows complet).
    $hwDiskType = ''
    $pd = Get-PhysicalDisk -ErrorAction SilentlyContinue | Where-Object { "$($_.DeviceId)" -eq "$diskNum" } | Select-Object -First 1
    if (-not $pd) { $pd = Get-PhysicalDisk -ErrorAction SilentlyContinue | Select-Object -First 1 }
    if ($pd) {
        $mt = "$($pd.MediaType)"   # SSD / HDD / Unspecified
        $bt = "$($pd.BusType)"     # NVMe / SATA / RAID / USB...
        if     ($bt -eq 'NVMe')  { $hwDiskType = 'SSD NVMe' }
        elseif ($mt -eq 'SSD')   { $hwDiskType = if ($bt) { "SSD ($bt)" } else { 'SSD' } }
        elseif ($mt -eq 'HDD')   { $hwDiskType = 'HDD' }
        elseif ($mt)             { $hwDiskType = $mt }
        elseif ($bt)             { $hwDiskType = $bt }
    }
    Write-Log "Materiel : $hwModel | S/N : $hwSerial | RAM : ${hwRamGb} Go | Disque : ${hwDiskGb} Go $hwDiskType | CPU : $hwCpu"

    if ($mac) {
        $hwBody = @{ serial = $hwSerial; model = $hwModel; ram_gb = $hwRamGb; disk_gb = $hwDiskGb; disk_type = $hwDiskType; cpu = $hwCpu } | ConvertTo-Json
        Invoke-WebRequest -Uri "$osirisUrl/machines/$mac/hardware" `
            -Method POST -Body $hwBody -ContentType "application/json" `
            -UseBasicParsing -TimeoutSec 10 -ErrorAction Stop | Out-Null
        Write-Log "Inventaire materiel envoye a OSIRIS"
    }
} catch {
    Write-Log "AVERTISSEMENT : collecte materiel echouee - $_"
}

# ── Callback "deployed" ──────────────────────────────────────────────────────
if ($mac) {
    try {
        $resp = Invoke-WebRequest -Uri "$osirisUrl/machines/$mac/status?status=deployed" `
            -Method POST -UseBasicParsing -TimeoutSec 10 -ErrorAction Stop
        Write-Log "Statut 'deployed' confirme (HTTP $($resp.StatusCode))"
    } catch {
        Write-Log "AVERTISSEMENT : callback echoue - $_"
    }
}

{% if profile.join_domain and profile.domain_join_user and profile.domain_join_password %}
# ── Jonction au domaine AD ────────────────────────────────────────────────────
# L'unattend.xml tente deja la jonction, mais pendant la passe *specialize* :
# AVANT que Windows ait installe le pilote de la carte reseau. Avec une carte
# integree (pilote inbox, disponible immediatement) ca passe ; avec un adaptateur
# USB-Ethernet la machine n'a pas encore d'adresse IP, la jonction echoue SANS
# erreur visible et l'OOBE se termine normalement.
# Ici le reseau est garanti : le script l'a explicitement attendu plus haut.
# On ne rejoue donc la jonction que si elle n'a pas deja abouti.
$csDom = Get-CimInstance Win32_ComputerSystem -ErrorAction SilentlyContinue
if ($csDom -and $csDom.PartOfDomain) {
    Write-Log "Domaine : deja joint a $($csDom.Domain) (via unattend)"
} else {
    Write-Log "Domaine : non joint - jonction a {{ profile.domain }} depuis le firstboot..."
    try {
        # here-strings litterales : aucune interpolation du mot de passe, qui peut
        # contenir $ ` | et autres caracteres speciaux.
        $djPwdPlain = @'
{{ profile.domain_join_password }}
'@.Trim()
        $djUser = @'
{{ profile.domain_join_user }}
'@.Trim()
        # Qualification OBLIGATOIRE du domaine : un nom nu ("m2smasterisation") est
        # interprete comme un compte LOCAL depuis une machine en WORKGROUP, et la
        # jonction echoue en 0x52e "nom d'utilisateur ou mot de passe incorrect"
        # MEME avec le bon mot de passe (constate en prod chez midi2i le 24/07 :
        # "dca_cderycke" refuse, "midi2i.com\dca_cderycke" accepte, meme mdp).
        # L'unattend.xml n'a pas ce probleme : il a une balise <Domain> separee.
        # On ne prefixe que si l'utilisateur n'a pas deja qualifie (DOM\user ou user@dom).
        if ($djUser -notmatch '[\\@]') {
            $djUser = '{{ profile.domain }}\' + $djUser
            Write-Log "Domaine : compte de jonction qualifie en $djUser"
        }
        $djCred = New-Object System.Management.Automation.PSCredential(
            $djUser, (ConvertTo-SecureString $djPwdPlain -AsPlainText -Force))
        $djArgs = @{
            DomainName  = '{{ profile.domain }}'
            Credential  = $djCred
            Force       = $true
            ErrorAction = 'Stop'
        }
{% if machine.ou %}
        $djArgs['OUPath'] = @'
{{ machine.ou }}
'@.Trim()
{% endif %}
        # Reprise sur echec RESEAU uniquement. La jonction se joue quelques secondes
        # apres le demarrage du firstboot : le lien vers le DC (tunnel VPN chez les
        # clients distants) n'est pas toujours etabli. Constate le 04/08 sur M2KL099 :
        # tunnel midi2i tombe -> "Le domaine specifie n'existe pas ou n'a pas pu etre
        # contacte" -> jonction a refaire a la main.
        #
        # On ne reessaie JAMAIS une erreur d'identifiants (0x52e) : le compte de
        # jonction est un compte de service, et cinq tentatives de suite le feraient
        # verrouiller par la strategie AD. Mauvais mot de passe = on s'arrete net.
        $djMaxEssais = 5
        $djAttente   = 30
        for ($djEssai = 1; $djEssai -le $djMaxEssais; $djEssai++) {
            try {
                Add-Computer @djArgs
                Write-Log "Domaine : jonction reussie a {{ profile.domain }} (effective au redemarrage final)"
                break
            } catch {
                $djErr = "$_"
                # 0x52e / 1326 : identifiants refuses. Inutile et dangereux d'insister.
                # \b autour de 1326 : sans lui, un hote nomme "M2KL1326" ferait
                # passer une panne reseau pour un refus d'identifiants.
                if ($djErr -match '0x52e|\b1326\b|mot de passe|password|informations d.identification|credential') {
                    Write-Log "ERREUR jonction domaine {{ profile.domain }} : identifiants refuses - $djErr"
                    Write-Log "  (compte de jonction incorrect : aucune nouvelle tentative, pour ne pas le verrouiller)"
                    break
                }
                if ($djEssai -eq $djMaxEssais) {
                    Write-Log "ERREUR jonction domaine {{ profile.domain }} apres $djMaxEssais essais : $djErr"
                    Write-Log "  (le domaine est reste injoignable : verifier le lien reseau / le tunnel VPN)"
                    break
                }
                Write-Log "Domaine injoignable (essai $djEssai/$djMaxEssais) - nouvelle tentative dans $djAttente s..."
                Start-Sleep -Seconds $djAttente
            }
        }
    } catch {
        Write-Log "ERREUR jonction domaine {{ profile.domain }} : $_"
    }
}
{% endif %}

# ── LAPS - Mot de passe administrateur local unique ───────────────────────────
# Sert aussi de garde-fou : on ne supprimera le compte de deploiement osiris-admin
# a la fin que si un AUTRE admin local utilisable existe (Administrateur integre
# active + mot de passe connu d'OSIRIS). Sinon on garderait osiris-admin pour ne
# pas verrouiller la machine hors de tout admin local.
$script:localAdminReady = $false
Write-Log "Generation du mot de passe administrateur local (LAPS)..."
try {
    $chars = 'abcdefghjkmnpqrstuvwxyzABCDEFGHJKMNPQRSTUVWXYZ23456789!@#$%'.ToCharArray()
    $lapsPassword = -join ((1..16) | ForEach-Object { $chars | Get-Random })
    $secLaps = ConvertTo-SecureString $lapsPassword -AsPlainText -Force
    # Compte administrateur integre retrouve par son SID (RID 500) - le nom "Administrator"
    # peut differer selon la langue/renommage, mais le RID 500 est toujours l'administrateur integre.
    $adminAccount = Get-LocalUser | Where-Object { $_.SID -like "*-500" } | Select-Object -First 1
    if (-not $adminAccount) { throw "Compte administrateur integre (RID 500) introuvable" }
    Set-LocalUser -Name $adminAccount.Name -Password $secLaps -ErrorAction Stop
    Enable-LocalUser -Name $adminAccount.Name -ErrorAction SilentlyContinue
    Write-Log "Mot de passe administrateur local defini ($($adminAccount.Name))"

    if ($mac) {
        $lapsBody = @{ password = $lapsPassword } | ConvertTo-Json
        Invoke-WebRequest -Uri "$osirisUrl/machines/$mac/laps-password" `
            -Method POST -Body $lapsBody -ContentType "application/json" `
            -UseBasicParsing -TimeoutSec 10 | Out-Null
        Write-Log "Mot de passe LAPS sauvegarde dans OSIRIS"
    }
    # Administrateur integre actif + mot de passe sauvegarde : on a un admin local
    # de secours, la suppression d'osiris-admin est donc sans danger.
    $script:localAdminReady = $true
} catch {
    Write-Log "AVERTISSEMENT : LAPS echoue - $_"
}

{% if profile.enable_bitlocker %}
# ── BitLocker ─────────────────────────────────────────────────────────────────
{% if profile.bitlocker_pin %}
Write-Log "Activation de BitLocker (mode TPM + PIN)..."
{% else %}
Write-Log "Activation de BitLocker (mode TPM automatique)..."
{% endif %}
try {
    $tpm = Get-Tpm -ErrorAction Stop
    if (-not $tpm.TpmPresent -or -not $tpm.TpmReady) {
        Write-Log "AVERTISSEMENT : TPM absent ou non pret - BitLocker ignore"
    } else {
        $blVol = Get-BitLockerVolume -MountPoint "C:" -ErrorAction Stop

        # Recuperer ou generer la cle de recuperation
        $existingKey = ($blVol.KeyProtector | Where-Object { $_.KeyProtectorType -eq "RecoveryPassword" } | Select-Object -First 1).RecoveryPassword
        if (-not $existingKey) {
            Add-BitLockerKeyProtector -MountPoint "C:" -RecoveryPasswordProtector -ErrorAction Stop | Out-Null
            $blVol = Get-BitLockerVolume -MountPoint "C:"
            $existingKey = ($blVol.KeyProtector | Where-Object { $_.KeyProtectorType -eq "RecoveryPassword" } | Select-Object -First 1).RecoveryPassword
        }

        {% if profile.bitlocker_pin %}
        # Mode TPM + PIN : generer un PIN aleatoire a 6 chiffres
        $pin = (Get-Random -Minimum 100000 -Maximum 999999).ToString()
        $securePin = ConvertTo-SecureString $pin -AsPlainText -Force

        # Windows bloque le PIN au demarrage par defaut (strategie de groupe locale non
        # configuree) - on active la strategie equivalente via registre pour l'autoriser.
        $fvePath = "HKLM:\SOFTWARE\Policies\Microsoft\FVE"
        if (-not (Test-Path $fvePath)) { New-Item -Path $fvePath -Force | Out-Null }
        Set-ItemProperty -Path $fvePath -Name "UseAdvancedStartup" -Value 1 -Type DWord
        Set-ItemProperty -Path $fvePath -Name "UseTPMPIN" -Value 2 -Type DWord
        Set-ItemProperty -Path $fvePath -Name "UseTPM" -Value 2 -Type DWord

        $hasTpmPin = ($blVol.KeyProtector | Where-Object { $_.KeyProtectorType -eq "TpmPin" }).Count -gt 0

        if ($blVol.ProtectionStatus -eq "On") {
            # Chiffrement deja actif (execution precedente reussie) : juste s'assurer que le
            # protecteur PIN existe, sans repasser par Enable-BitLocker.
            if (-not $hasTpmPin) {
                Add-BitLockerKeyProtector -MountPoint "C:" -TpmAndPinProtector -Pin $securePin -ErrorAction Stop | Out-Null
            }
        } else {
            # Chiffrement pas encore actif. Le PIN est regenere aleatoirement a chaque execution
            # (voir $pin ci-dessus) : si un protecteur TpmPin existe deja (execution precedente
            # interrompue, avec un PIN different), on le retire d'abord - Windows n'autorise
            # qu'un seul protecteur de ce type par volume. Puis Enable-BitLocker ajoute le
            # protecteur ET demarre le chiffrement en un seul appel (obligatoire : Enable-BitLocker
            # exige un switch de type de protecteur pour resoudre son jeu de parametres).
            if ($hasTpmPin) {
                $oldProtectorId = ($blVol.KeyProtector | Where-Object { $_.KeyProtectorType -eq "TpmPin" } | Select-Object -First 1).KeyProtectorId
                Remove-BitLockerKeyProtector -MountPoint "C:" -KeyProtectorId $oldProtectorId -ErrorAction SilentlyContinue
            }
            Enable-BitLocker -MountPoint "C:" -EncryptionMethod XtsAes256 -TpmAndPinProtector -Pin $securePin -SkipHardwareTest -ErrorAction Stop | Out-Null
        }
        Write-Log "BitLocker TPM+PIN active - PIN : $pin"

        if ($mac) {
            $blBody = @{ key = $existingKey; pin = $pin } | ConvertTo-Json
            Invoke-WebRequest -Uri "$osirisUrl/machines/$mac/bitlocker-key" `
                -Method POST -Body $blBody -ContentType "application/json" `
                -UseBasicParsing -TimeoutSec 10 | Out-Null
            Write-Log "PIN et cle de recuperation sauvegardes dans OSIRIS"
        }
        {% else %}
        # Mode TPM seul : demarrage automatique
        if ($blVol.ProtectionStatus -ne "On") {
            Enable-BitLocker -MountPoint "C:" -EncryptionMethod XtsAes256 `
                -TpmProtector -SkipHardwareTest -ErrorAction Stop | Out-Null
        }
        Write-Log "BitLocker TPM seul active"

        if ($mac -and $existingKey) {
            $blBody = @{ key = $existingKey } | ConvertTo-Json
            Invoke-WebRequest -Uri "$osirisUrl/machines/$mac/bitlocker-key" `
                -Method POST -Body $blBody -ContentType "application/json" `
                -UseBasicParsing -TimeoutSec 10 | Out-Null
            Write-Log "Cle de recuperation sauvegardee dans OSIRIS"
        }
        {% endif %}
    }
} catch {
    Write-Log "AVERTISSEMENT : BitLocker echoue - $_"
}
{% else %}
Write-Log "BitLocker desactive sur ce profil."
{% endif %}

{% if win_apps %}
# ── Applications winget ───────────────────────────────────────────────────────
# winget est un alias d'execution lie au profil utilisateur interactif : il n'est
# pas resolu dans le PATH a ce stade (FirstLogonCommands tourne avant que le
# profil complet soit charge). On resout donc le chemin complet de l'exe.
function Get-WingetPath {
    $pkg = Get-AppxPackage -Name "Microsoft.DesktopAppInstaller" -AllUsers -ErrorAction SilentlyContinue | Select-Object -First 1
    if ($pkg) {
        $exe = Join-Path $pkg.InstallLocation "winget.exe"
        if (Test-Path $exe) { return $exe }
    }
    return $null
}
$wingetExe = Get-WingetPath

Write-Log "Installation des applications via winget..."
$apps = @(
{% for app in win_apps if app.install_type == 'winget' and app.winget_id %}
    "{{ app.winget_id }}"{{ "," if not loop.last else "" }}
{% endfor %}
)
if (-not $wingetExe) {
    Write-Log "AVERTISSEMENT : winget introuvable sur ce systeme - applications non installees."
} else {
    # Certains installeurs (Firefox, OpenVPN...) declenchent une invite UAC malgre
    # le --silent, meme en contexte deja admin - invisible et bloquante sur console
    # noVNC (bascule Secure Desktop qui ne s'affiche pas). On la desactive le temps
    # des installs, puis on restaure la valeur d'origine.
    $uacPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"
    $uacOriginal = (Get-ItemProperty -Path $uacPath -Name ConsentPromptBehaviorAdmin -EA SilentlyContinue).ConsentPromptBehaviorAdmin
    Set-ItemProperty -Path $uacPath -Name ConsentPromptBehaviorAdmin -Value 0 -Type DWord -EA SilentlyContinue

    $total = $apps.Count
    $i = 0
    foreach ($appId in $apps) {
        $i++
        Write-Progress -Activity "Installation des applications" `
            -Status "$appId ($i/$total)" -PercentComplete (($i - 1) / $total * 100)
        # --source winget : on force la source communautaire (qui contient nos apps)
        # et on ignore msstore, dont le CDN (storeedgefd.dsx.mp.microsoft.com) peut
        # etre injoignable/filtre sur le reseau client. Sans ca, l'erreur msstore
        # fait echouer winget alors que le paquet existe dans la source winget.
        & $wingetExe install --id $appId -e `
            --source winget `
            --accept-source-agreements `
            --accept-package-agreements `
            --silent 2>&1 | ForEach-Object { Write-LogFile "  $_" }
        Write-Log "winget : $appId $(if ($LASTEXITCODE -eq 0) { 'OK' } else { "ECHEC (code $LASTEXITCODE)" })"
    }
    Write-Progress -Activity "Installation des applications" -Completed

    if ($null -ne $uacOriginal) {
        Set-ItemProperty -Path $uacPath -Name ConsentPromptBehaviorAdmin -Value $uacOriginal -Type DWord -EA SilentlyContinue
    } else {
        Remove-ItemProperty -Path $uacPath -Name ConsentPromptBehaviorAdmin -EA SilentlyContinue
    }
}
Write-Log "Applications installees."
{% endif %}

{% set custom_apps = win_apps | rejectattr('install_type', 'equalto', 'winget') | selectattr('installer_file') | list %}
{% if custom_apps %}
# ── Applications a installeur dedie (MSI/EXE heberge par OSIRIS) ───────────────
# Pour les apps a licence/enrolement que winget ne gere pas (ex: WithSecure : le
# VOUCHER = cle d'abonnement est passe en argument). L'installeur est telecharge
# depuis OSIRIS puis lance en silencieux.
Write-Log "Installation des applications a installeur dedie..."
$uacPath2 = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"
$uacOrig2 = (Get-ItemProperty -Path $uacPath2 -Name ConsentPromptBehaviorAdmin -EA SilentlyContinue).ConsentPromptBehaviorAdmin
Set-ItemProperty -Path $uacPath2 -Name ConsentPromptBehaviorAdmin -Value 0 -Type DWord -EA SilentlyContinue
{% for app in custom_apps %}
$tmpDir = Join-Path $env:TEMP ("osiris-inst-" + [guid]::NewGuid().ToString('N').Substring(0,8))
try {
    New-Item -ItemType Directory -Path $tmpDir -Force | Out-Null
    $dst = Join-Path $tmpDir "{{ app.installer_file }}"
    Write-Log "Telechargement de l'installeur {{ app.name }}..."
    Invoke-WebRequest -Uri "$osirisUrl/static/installers/{{ app.installer_file }}" -OutFile $dst -UseBasicParsing -TimeoutSec 600 -ErrorAction Stop
    {% if app.installer_config_file %}
    # Fichier compagnon (ex: configuration.xml de l'Office Deployment Tool), a cote de l'exe
    Invoke-WebRequest -Uri "$osirisUrl/static/installers/{{ app.installer_config_file }}" -OutFile (Join-Path $tmpDir "{{ app.installer_config_file }}") -UseBasicParsing -TimeoutSec 120 -ErrorAction Stop
    {% endif %}
    Write-Log ">>> Installation de {{ app.name }} en cours - PEUT PRENDRE 15-20 MIN (telechargement + install). NE PAS ETEINDRE LE PC. <<<"
    {% if app.install_type == 'msi' %}
    $proc = Start-Process -FilePath "msiexec.exe" -ArgumentList ('/i "' + $dst + '" {{ app.install_args }}') -Wait -PassThru -WindowStyle Hidden
    {% else %}
    # WorkingDirectory = dossier temp : les chemins relatifs des args (ex: /configure conf.xml) s'y resolvent
    $proc = Start-Process -FilePath $dst -ArgumentList '{{ app.install_args }}' -WorkingDirectory $tmpDir -Wait -PassThru -WindowStyle Hidden
    {% endif %}
    Write-Log "{{ app.name }} : installeur termine (code $($proc.ExitCode))"
} catch {
    Write-Log "AVERTISSEMENT : {{ app.name }} - installeur echoue : $_"
} finally {
    Remove-Item -LiteralPath $tmpDir -Recurse -Force -EA SilentlyContinue
}
{% endfor %}
if ($null -ne $uacOrig2) { Set-ItemProperty -Path $uacPath2 -Name ConsentPromptBehaviorAdmin -Value $uacOrig2 -Type DWord -EA SilentlyContinue }
else { Remove-ItemProperty -Path $uacPath2 -Name ConsentPromptBehaviorAdmin -EA SilentlyContinue }
{% endif %}

# ── TeamViewer : acceptation du CLUF (mot de passe configure MANUELLEMENT) ─────
# L'automatisation du mot de passe TeamViewer via `--passwd` a ete abandonnee :
# la commande lance l'appli qui ne se ferme pas et FIGE le firstboot, et le
# resultat est de toute facon peu fiable (TeamViewer 15+). On se contente donc
# d'accepter le CLUF pour que TV soit utilisable ; le mot de passe d'acces non
# surveille se configure a la main (10 s), c'est negligeable vs le reste automatise.
$tvExe = if (Test-Path "C:\Program Files\TeamViewer\TeamViewer.exe") {
    "C:\Program Files\TeamViewer\TeamViewer.exe"
} elseif (Test-Path "C:\Program Files (x86)\TeamViewer\TeamViewer.exe") {
    "C:\Program Files (x86)\TeamViewer\TeamViewer.exe"
} else { $null }
if ($tvExe) {
    foreach ($p in @("HKLM:\SOFTWARE\TeamViewer", "HKLM:\SOFTWARE\WOW6432Node\TeamViewer")) {
        if (Test-Path $p) { Set-ItemProperty -Path $p -Name "LicenseAccepted" -Value 1 -Type DWord -EA SilentlyContinue }
    }
    Write-Log "TeamViewer : installe, CLUF accepte (mot de passe a configurer manuellement)."
}

{% if profile.join_domain and profile.wifi_ssid %}
# ── Profil WiFi (pousse pour les machines qui joignent ce domaine) ────────────
Write-Log "Configuration du profil WiFi {{ profile.wifi_ssid }}..."
try {
    # here-strings litterales @' '@ : aucune interpolation PowerShell du SSID/mdp
    $wifiSsid = @'
{{ profile.wifi_ssid }}
'@.Trim()
    $wifiPass = @'
{{ profile.wifi_password }}
'@.Trim()
    $ssidX = [System.Security.SecurityElement]::Escape($wifiSsid)
    $passX = [System.Security.SecurityElement]::Escape($wifiPass)
    $wifiXml = @"
<?xml version="1.0"?>
<WLANProfile xmlns="http://www.microsoft.com/networking/WLAN/profile/v1">
  <name>$ssidX</name>
  <SSIDConfig><SSID><name>$ssidX</name></SSID></SSIDConfig>
  <connectionType>ESS</connectionType>
  <connectionMode>auto</connectionMode>
  <MSM><security>
    <authEncryption><authentication>WPA2PSK</authentication><encryption>AES</encryption><useOneX>false</useOneX></authEncryption>
    <sharedKey><keyType>passPhrase</keyType><protected>false</protected><keyMaterial>$passX</keyMaterial></sharedKey>
  </security></MSM>
</WLANProfile>
"@
    $wifiFile = Join-Path $env:TEMP "osiris-wifi.xml"
    Set-Content -Path $wifiFile -Value $wifiXml -Encoding UTF8
    # user=all : profil disponible pour tous les utilisateurs de la machine.
    # Sur un poste sans carte WiFi, netsh renvoie une erreur non bloquante (catch).
    $wifiOut = netsh wlan add profile filename="$wifiFile" user=all 2>&1
    Remove-Item $wifiFile -Force -ErrorAction SilentlyContinue
    if ($LASTEXITCODE -eq 0) { Write-Log "WiFi : profil $wifiSsid ajoute" }
    else { Write-Log "WiFi : non ajoute ($wifiOut)" }
} catch {
    Write-Log "AVERTISSEMENT WiFi : $_"
}
{% endif %}

