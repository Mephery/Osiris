{% if profile.laps_rotation_days > 0 %}
# ── LAPS : rotation automatique ───────────────────────────────────────────────
Write-Log "Installation du script de rotation LAPS (tous les {{ profile.laps_rotation_days }} jours)..."

$lapsScript = @'
#Requires -RunAsAdministrator
# OSIRIS - Rotation automatique du mot de passe administrateur local (LAPS)
$osirisUrl = "{{ osiris_url }}"
$ErrorActionPreference = "Stop"

try {
    $mac = (Get-NetAdapter | Where-Object { $_.Status -eq "Up" -and $_.MacAddress -ne "" } `
        | Sort-Object -Property InterfaceIndex | Select-Object -First 1).MacAddress -replace '-', '' -replace ':', ''

    $check = Invoke-RestMethod -Uri "$osirisUrl/machines/$mac/laps-due" -Method GET -TimeoutSec 10
    if (-not $check.due) { exit 0 }

    $chars = 'abcdefghjkmnpqrstuvwxyzABCDEFGHJKMNPQRSTUVWXYZ23456789!@#$%'.ToCharArray()
    $newPassword = -join ((1..16) | ForEach-Object { $chars | Get-Random })
    $securePassword = ConvertTo-SecureString $newPassword -AsPlainText -Force

    # Meme logique que le firstboot : retrouver l'administrateur integre par SID (RID 500).
    $adminAccount = Get-LocalUser | Where-Object { $_.SID -like "*-500" } | Select-Object -First 1
    if (-not $adminAccount) { throw "Compte administrateur integre (RID 500) introuvable" }
    Set-LocalUser -Name $adminAccount.Name -Password $securePassword -ErrorAction Stop

    $body = @{ password = $newPassword } | ConvertTo-Json
    Invoke-RestMethod -Uri "$osirisUrl/machines/$mac/laps-password" -Method POST `
        -ContentType "application/json" -Body $body -TimeoutSec 10 | Out-Null

    Write-EventLog -LogName Application -Source "OSIRIS" -EventId 1042 `
        -EntryType Information -Message "LAPS : mot de passe $($adminAccount.Name) renouvele." `
        -ErrorAction SilentlyContinue
} catch {
    Write-EventLog -LogName Application -Source "OSIRIS" -EventId 1043 `
        -EntryType Warning -Message "LAPS : echec de la rotation - $_" `
        -ErrorAction SilentlyContinue
}
'@

$lapsScriptPath = "C:\Windows\System32\osiris-laps-renew.ps1"
Set-Content -Path $lapsScriptPath -Value $lapsScript -Encoding UTF8

# Enregistrer la source d'evenement Windows si elle n'existe pas
if (-not [System.Diagnostics.EventLog]::SourceExists("OSIRIS")) {
    New-EventLog -LogName Application -Source "OSIRIS" -ErrorAction SilentlyContinue
}

# Tache planifiee : rotation au demarrage, sous SYSTEM
$action    = New-ScheduledTaskAction -Execute "PowerShell.exe" `
    -Argument "-NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File `"$lapsScriptPath`""
$trigger   = New-ScheduledTaskTrigger -AtStartup
$principal = New-ScheduledTaskPrincipal -UserId "SYSTEM" -LogonType ServiceAccount -RunLevel Highest
$settings  = New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Minutes 5)
Register-ScheduledTask -TaskName "OSIRIS-LAPS-Renewal" `
    -Action $action -Trigger $trigger -Principal $principal -Settings $settings `
    -Description "OSIRIS - Rotation automatique LAPS tous les {{ profile.laps_rotation_days }} jours" `
    -Force | Out-Null
Write-Log "Tache planifiee OSIRIS-LAPS-Renewal creee."
{% endif %}

Write-Log "Premier demarrage OSIRIS termine."

# ── Smoke tests ───────────────────────────────────────────────────────────────
Write-Log "Smoke tests post-deploiement..."
$smokeTests = @()

function Add-SmokeTest($name, $ok, $detail = "") {
    $script:smokeTests += @{ name = $name; ok = $ok; detail = $detail }
    $icon = if ($ok) { "OK" } else { "FAIL" }
    Write-Log "  [$icon] $name$(if ($detail) { ' : ' + $detail } else { '' })"
}

# Ping passerelle par defaut
try {
    $gw = (Get-NetRoute -DestinationPrefix "0.0.0.0/0" | Sort-Object RouteMetric | Select-Object -First 1).NextHop
    $ping = Test-Connection -ComputerName $gw -Count 1 -Quiet -ErrorAction Stop
    Add-SmokeTest "Ping passerelle ($gw)" $ping
} catch {
    Add-SmokeTest "Ping passerelle" $false "Erreur : $_"
}

# Resolution DNS
try {
    $dns = [System.Net.Dns]::GetHostEntry("www.google.com") -ne $null
    Add-SmokeTest "Resolution DNS" $true
} catch {
    Add-SmokeTest "Resolution DNS" $false "Echec : $_"
}

{% if profile.join_domain %}
# Jonction domaine AD
try {
    $inDomain = (Get-WmiObject Win32_ComputerSystem).PartOfDomain
    Add-SmokeTest "Jonction domaine AD" $inDomain $(if ($inDomain) { (Get-WmiObject Win32_ComputerSystem).Domain } else { "Non joint" })
} catch {
    Add-SmokeTest "Jonction domaine AD" $false "Erreur : $_"
}
{% endif %}

# Service TeamViewer
try {
    $tv = Get-Service -Name "TeamViewer" -ErrorAction Stop
    $tvOk = $tv.Status -eq "Running"
    Add-SmokeTest "TeamViewer" $tvOk $tv.Status.ToString()
} catch {
    Add-SmokeTest "TeamViewer" $false "Service introuvable"
}

{% if win_apps %}
# Presence des applications installees
{% for app in win_apps %}
try {
    {% if app.install_type == 'winget' and app.winget_id %}
    if (-not $wingetExe) { throw "winget introuvable" }
    # --source winget : evite l'erreur msstore lors de la correlation (voir install)
    $appOut = & $wingetExe list --id "{{ app.winget_id }}" -e --source winget --accept-source-agreements 2>&1
    $appOk = $LASTEXITCODE -eq 0
    {% else %}
    # Installeur custom (ex: WithSecure) : verifier la presence dans les programmes installes
    $appOk = $null -ne (Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*','HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*' -EA SilentlyContinue | Where-Object { $_.DisplayName -like "*{{ app.detect_name or app.name }}*" })
    {% endif %}
    Add-SmokeTest "App : {{ app.name }}" $appOk $(if ($appOk) { "Installe" } else { "Non trouve" })
} catch {
    Add-SmokeTest "App : {{ app.name }}" $false "Erreur"
}
{% endfor %}
{% endif %}

# Envoi du rapport a OSIRIS
try {
    $body = @{ tests = @($smokeTests) } | ConvertTo-Json -Depth 5 -Compress
    # Invoke-WebRequest encode -Body (string) avec l'encodage par defaut du systeme,
    # qui peut differer de l'UTF-8 attendu par le serveur - on force les octets UTF-8.
    $bodyBytes = [System.Text.Encoding]::UTF8.GetBytes($body)
    Invoke-WebRequest -Uri "$osirisUrl/machines/$($script:_mac)/smoke-tests" `
        -Method POST -Body $bodyBytes -ContentType "application/json; charset=utf-8" `
        -UseBasicParsing -TimeoutSec 15 | Out-Null
    Write-Log "Rapport smoke tests envoye."
} catch {
    Write-Log "AVERTISSEMENT : Echec envoi rapport smoke tests - $_"
}

{% if bios_password %}
# ── Mot de passe administrateur BIOS ──────────────────────────────────────────
# Pose via DellBIOSProvider (module Dell, successeur de cctk.exe). Uniquement sur
# du materiel Dell : ailleurs on passe silencieusement, ce n'est pas une erreur.
# Place APRES les smoke tests : un echec ici ne doit pas faire echouer le rapport.
Write-Log "Configuration du mot de passe administrateur BIOS..."
try {
    $sysMgr = (Get-CimInstance Win32_ComputerSystem -EA Stop).Manufacturer
    if ($sysMgr -notmatch 'Dell') {
        Write-Log "Materiel non-Dell ($sysMgr) : mot de passe BIOS ignore."
    } else {
        # Module servi par OSIRIS, PAS installe depuis PSGallery. Le PowerShellGet
        # livre en boite avec Windows 11 est en 1.0.0.1 : il ne connait pas
        # -AcceptLicense (echec constate le 30/07 sur M2KL098 : "Impossible de
        # trouver un parametre correspondant au nom AcceptLicense") et n'amorce pas
        # le fournisseur NuGet en session non interactive. Un simple decompactage
        # dans le chemin des modules suffit : Import-Module n'a besoin ni de
        # PowerShellGet, ni d'un acces Internet depuis le poste du client.
        if (-not (Get-Module -ListAvailable -Name DellBIOSProvider)) {
            $modDir = Join-Path $env:ProgramFiles 'WindowsPowerShell\Modules\DellBIOSProvider'
            $modZip = Join-Path $env:TEMP 'DellBIOSProvider.zip'
            Write-Log "Module DellBIOSProvider absent - recuperation depuis OSIRIS..."
            Invoke-WebRequest -Uri "$osirisUrl/static/installers/DellBIOSProvider.zip" `
                -OutFile $modZip -UseBasicParsing -TimeoutSec 120 -EA Stop
            New-Item -ItemType Directory -Path $modDir -Force | Out-Null
            Expand-Archive -Path $modZip -DestinationPath $modDir -Force -EA Stop
            # Un fichier telecharge peut porter la marque "provenance Internet" ;
            # le chargement d'une DLL bloquee echouerait.
            Get-ChildItem $modDir -Recurse -File | Unblock-File -EA SilentlyContinue
            Remove-Item $modZip -Force -EA SilentlyContinue
            Write-Log "Module DellBIOSProvider installe."
        }
        Import-Module DellBIOSProvider -Force -Verbose:$false -EA Stop

        $biosPwd = '{{ bios_password | replace("'", "''") }}'
        $alreadySet = (Get-Item -Path DellSmbios:\Security\IsAdminPasswordSet).CurrentValue -eq 'True'
        if ($alreadySet) {
            # Deja pose (re-deploiement d'une machine du parc) : on ne connait pas
            # forcement l'ancien, et le reappliquer a l'identique echouerait de toute
            # facon. On laisse en place plutot que de casser quoi que ce soit.
            Write-Log "Mot de passe BIOS deja defini - conserve tel quel."
        } else {
            Set-Item -Path DellSmbios:\Security\AdminPassword -Value $biosPwd -EA Stop
            Write-Log "Mot de passe administrateur BIOS applique."
        }
        $biosPwd = $null
    }
} catch {
    Write-Log "AVERTISSEMENT : Echec configuration mot de passe BIOS - $_"
    Write-Log "  (si le module est introuvable : deposer DellBIOSProvider.zip dans backend/static/installers/)"
}
{% endif %}

{% if forced_mac %}
# ── MAC imposee par la convention du client ───────────────────────────────────
# ATTENTION : override NDIS cote Windows uniquement. Le firmware continue de
# presenter la MAC gravee au boot PXE - ne JAMAIS compter dessus pour identifier
# la machine dans OSIRIS (c'est le role du numero de serie).
# En dernier car Set-NetAdapter redemarre l'interface : tout ce qui precede a
# besoin du reseau (jonction AD, winget, smoke tests).
$targetMac = '{{ forced_mac }}'
$targetMacFmt = ($targetMac -split '(..)' -ne '') -join ':'
Write-Log "Application de la MAC imposee : $targetMacFmt"
try {
    $adapters = @(Get-NetAdapter -Physical -EA Stop | Where-Object Status -eq 'Up')
    if ($adapters.Count -eq 0) {
        Write-Log "AVERTISSEMENT : aucun adaptateur physique actif - MAC non appliquee."
    } elseif ($adapters.Count -gt 1) {
        # Ambigu (dock + WiFi filaire, second dongle...) : on s'abstient plutot que
        # de reecrire la MAC du mauvais adaptateur.
        Write-Log "AVERTISSEMENT : $($adapters.Count) adaptateurs actifs ($($adapters.Name -join ', ')) - MAC non appliquee."
    } elseif (($adapters[0].MacAddress -replace '-', '') -ieq $targetMac) {
        Write-Log "MAC deja conforme."
    } else {
        Set-NetAdapter -Name $adapters[0].Name -MacAddress $targetMac -Confirm:$false -EA Stop
        Start-Sleep -Seconds 10   # redemarrage de l'interface + bail DHCP
        # Certains pilotes acceptent la commande sans honorer l'override : on relit.
        $after = (Get-NetAdapter -Name $adapters[0].Name).MacAddress -replace '-', ''
        if ($after -ieq $targetMac) {
            Write-Log "MAC appliquee : $targetMacFmt"
        } else {
            Write-Log "AVERTISSEMENT : le pilote n'a pas honore l'override (MAC = $after)."
        }
    }
} catch {
    Write-Log "AVERTISSEMENT : Echec application de la MAC - $_"
}
{% endif %}

# Progression a 100% : le deploiement (firstboot compris) est vraiment termine.
if ($script:_mac) {
    try {
        Invoke-WebRequest -Uri "$osirisUrl/machines/$($script:_mac)/deploy-progress?p=100" `
            -Method POST -UseBasicParsing -TimeoutSec 5 -ErrorAction SilentlyContinue | Out-Null
    } catch {}
}
Write-Log "===== DEPLOIEMENT TERMINE ====="

# ── Suppression du compte de deploiement osiris-admin ─────────────────────────
# Le firstboot tourne SOUS osiris-admin => impossible de se supprimer soi-meme.
# On planifie une tache SYSTEM au demarrage qui supprime le compte + son profil au
# prochain boot (autologon coupe => plus personne connecte dessus), puis se supprime.
# Restent uniquement : l'Administrateur integre (LAPS) + les comptes du domaine.
# Garde-fou : on ne le fait que si un admin local de secours existe (voir LAPS).
if ($script:localAdminReady) {
    try {
        $winlogon = "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon"
        Set-ItemProperty    -Path $winlogon -Name AutoAdminLogon -Value "0" -EA SilentlyContinue
        Remove-ItemProperty -Path $winlogon -Name DefaultPassword -EA SilentlyContinue
        Remove-ItemProperty -Path $winlogon -Name DefaultUserName -EA SilentlyContinue
        Remove-ItemProperty -Path $winlogon -Name AutoLogonCount  -EA SilentlyContinue

        $cleanup = @'
$ErrorActionPreference = "SilentlyContinue"
$target = "osiris-admin"
$prof = Get-CimInstance Win32_UserProfile | Where-Object { $_.LocalPath -like "*\$target" }
if ($prof) { Remove-CimInstance -InputObject $prof }
Remove-LocalUser -Name $target
Unregister-ScheduledTask -TaskName "OsirisCleanupAdmin" -Confirm:$false
Remove-Item -LiteralPath "C:\osiris-cleanup-admin.ps1" -Force
'@
        Set-Content -Path "C:\osiris-cleanup-admin.ps1" -Value $cleanup -Encoding UTF8
        $act  = New-ScheduledTaskAction -Execute "powershell.exe" -Argument "-NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File C:\osiris-cleanup-admin.ps1"
        $trg  = New-ScheduledTaskTrigger -AtStartup
        $prin = New-ScheduledTaskPrincipal -UserId "SYSTEM" -RunLevel Highest
        Register-ScheduledTask -TaskName "OsirisCleanupAdmin" -Action $act -Trigger $trg -Principal $prin -Force | Out-Null
        Write-Log "Compte osiris-admin : suppression planifiee au prochain demarrage"
    } catch {
        Write-Log "AVERTISSEMENT planification suppression osiris-admin : $_"
    }
} else {
    Write-Log "osiris-admin CONSERVE (aucun admin local de secours : LAPS a echoue)"
}

# ── Nettoyage ─────────────────────────────────────────────────────────────────
Start-Sleep -Seconds 2
Remove-Item -Path $MyInvocation.MyCommand.Path -Force -EA SilentlyContinue

{% if profile.bitlocker_pin %}
# BitLocker TPM+PIN : redemarrage MANUEL requis (le PIN est demande au boot).
# osiris-admin sera supprime a ce redemarrage par la tache planifiee.
Write-Log "Deploiement termine. Redemarrage manuel requis (BitLocker PIN) - osiris-admin sera supprime au boot."
{% else %}
# Redemarrage final : deconnecte osiris-admin et declenche son nettoyage au boot.
if ($script:localAdminReady) {
    Write-Log "Deploiement termine - redemarrage final (suppression osiris-admin)..."
    Start-Sleep -Seconds 3
    Restart-Computer -Force
}
{% endif %}
