#!/bin/bash
# OSIRIS - Premier demarrage - {{ machine.hostname }}
LOG=/var/log/osiris-firstboot.log
exec >> "$LOG" 2>&1

# Le fuseau accompagne l'heure : ces lignes finissent dans le journal de
# deploiement d'OSIRIS, a cote d'horodatages produits par le serveur. Une image
# cloud tourne en UTC et le serveur en heure locale — sans le suffixe, le journal
# melange deux horloges et personne ne s'en apercoit.
ts() { date '+%H:%M:%S %Z'; }
osiris_url="{{ osiris_url }}"
# MAC de la fiche OSIRIS, gravee ici a la generation du script. On ne la rededuit
# PAS de l'interface reseau : sur une machine a plusieurs cartes, celle qui porte
# la route par defaut n'est pas forcement celle qui identifie la fiche, et tous
# les rappels partaient alors sur une MAC inconnue d'OSIRIS.
_osiris_mac="{{ machine.mac }}"

# Une erreur n'interrompt pas le script (pas de `set -e`) : on continue, mais on
# retient qu'elle a eu lieu pour ne PAS annoncer un deploiement reussi a la fin.
_osiris_failed=0

_on_error() {
    local line=$1 cmd=$2
    echo "[$(ts)] ERREUR a la ligne $line : $cmd" | tee -a "$LOG"
    # Le detail part vers OSIRIS : un « failed » sans la commande fautive oblige
    # a se connecter a la machine pour comprendre, ce qui est rarement possible.
    curl -s -G -X POST "$osiris_url/machines/$_osiris_mac/log" \
        --data-urlencode "msg=firstboot ligne $line : $cmd" --max-time 10 > /dev/null || true
    if [ "$_osiris_failed" -eq 0 ]; then
        # Une seule fois : si le script mourait ici, l'echec serait quand meme visible.
        curl -s -X POST "$osiris_url/machines/$_osiris_mac/status?status=failed" --max-time 10 > /dev/null || true
        _osiris_failed=1
    fi
}
trap '_on_error $LINENO "$BASH_COMMAND"' ERR

# Envoie une ligne au journal de deploiement d'OSIRIS. Sur une machine distante
# sans acces console ni SSH, c'est le SEUL moyen de savoir ce qui s'est passe.
_osiris_log() {
    curl -s -G -X POST "$osiris_url/machines/$_osiris_mac/log" \
        --data-urlencode "msg=$1" --max-time 5 > /dev/null || true
}

# Trace une etape : dans le fichier local ET dans le journal d'OSIRIS.
#
# Le script redirige tout son stdout vers $LOG (`exec >>` plus haut), donc un
# simple `echo` ne quitte JAMAIS la machine. Le 2026-08-05, une VM deployee a
# distance n'a renvoye qu'UNE ligne a OSIRIS pour 41 ecrites en local : comprendre
# pourquoi un service n'etait pas installe et un volume pas monte imposait d'ouvrir
# une console sur la VM, ce qui est precisement ce qu'on ne peut pas faire sur un
# site client. Le firstboot Windows, lui, remonte ses 88 etapes depuis le 09/07.
#
# --max-time 5 (et non 10) : ces appels sont maintenant des dizaines, et un OSIRIS
# injoignable ne doit pas transformer le premier demarrage en interminable attente.
_log() {
    echo "[$(ts)] $1"
    _osiris_log "$1"
}

echo "[$(ts)] ============================================"
_log "OSIRIS First Boot - {{ machine.hostname }}"
echo "[$(ts)] ============================================"

# ── Nom d'hote ────────────────────────────────────────────────────────────────
# Pose en tout premier : la jonction AD, l'agent de supervision et le bail DHCP
# reprennent tous ce nom. Sans ca, une VM clonee depuis un template garde celui
# du template (« ubuntu ») et s'annonce sous ce nom partout.
_log "Application du nom d'hote : {{ machine.hostname }}"
hostnamectl set-hostname {{ machine.hostname | bash_squote }} \
    || echo "{{ machine.hostname }}" > /etc/hostname
if grep -q '^127\.0\.1\.1' /etc/hosts; then
    sed -i "s/^127\.0\.1\.1.*/127.0.1.1\t{{ machine.hostname }}/" /etc/hosts
else
    printf '127.0.1.1\t%s\n' '{{ machine.hostname }}' >> /etc/hosts
fi
# cloud-init repose le nom d'hote a chaque demarrage depuis les metadonnees du
# datasource, qui sur un clone portent encore celui du template : sans ce
# verrou, le nom qu'on vient de poser serait perdu au premier reboot.
mkdir -p /etc/cloud/cloud.cfg.d
printf 'preserve_hostname: true\n' > /etc/cloud/cloud.cfg.d/99-osiris-hostname.cfg

# ── Inventaire materiel ───────────────────────────────────────────────────────
_log "Collecte des informations materiel..."
HW_SERIAL=$(cat /sys/class/dmi/id/product_serial 2>/dev/null | tr -d '[:space:]') || HW_SERIAL=""
HW_MODEL=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null | tr -d '\n')
HW_PRODUCT=$(cat /sys/class/dmi/id/product_name 2>/dev/null | tr -d '\n')
HW_MODEL="$HW_MODEL $HW_PRODUCT"
HW_RAM_KB=$(grep MemTotal /proc/meminfo | awk '{print $2}')
HW_RAM_GB=$(( (HW_RAM_KB + 524288) / 1048576 ))
_log "Materiel : $HW_MODEL | S/N : $HW_SERIAL | RAM : ${HW_RAM_GB} Go"

curl -s -X POST "$osiris_url/machines/$_osiris_mac/hardware" \
    -H "Content-Type: application/json" \
    -d "{\"serial\":\"$HW_SERIAL\",\"model\":\"$HW_MODEL\",\"ram_gb\":$HW_RAM_GB}" || true
_log "Inventaire envoye a OSIRIS"

{% if tv_password %}
_log "Installation de TeamViewer Host..."
wget -q https://download.teamviewer.com/download/linux/teamviewer-host_amd64.deb \
     -O /tmp/osiris-tv.deb
apt-get install -y /tmp/osiris-tv.deb
rm -f /tmp/osiris-tv.deb

systemctl enable teamviewerd
systemctl start teamviewerd

_log "Attente du daemon TeamViewer..."
for i in $(seq 1 10); do
    sleep 3
    if teamviewer info 2>/dev/null | grep -q "TeamViewer ID"; then
        break
    fi
done

teamviewer passwd {{ tv_password | bash_squote }}
_log "TeamViewer configure - ID : $(teamviewer info 2>/dev/null | grep 'TeamViewer ID' | awk '{print $NF}')"
{% endif %}

{% if linux_apps %}
_log "Installation des applications via apt..."
# Non fatal, et DIT. Un VLAN serveur qui ne sort pas est la norme, pas une panne :
# les depots sont alors injoignables, et ce qui suit se debrouille avec ce qui est
# deja present (souvent grave dans le gabarit, sinon servi par OSIRIS). Laisser
# cette commande nue faisait declencher le piege ERR et marquait en echec un
# deploiement par ailleurs parfaitement reussi — constate le 17/09.
apt-get update -qq || _log "AVERTISSEMENT : depots injoignables - on poursuit avec le cache local"
{% for app in linux_apps %}
# Le compte rendu suit le RESULTAT. Annoncer « Installe » sans regarder faisait
# dire a OSIRIS qu'un paquet etait pose sur une machine ou apt venait d'echouer,
# faute de route vers les depots — un mensonge que rien ne rattrapait, puisque le
# smoke test cense le verifier ne s'executait jamais (voir plus bas). Un echec
# n'interrompt pas le deploiement, le reste de la configuration vaut d'etre
# applique, mais il se voit.
if apt-get install -y {{ app.apt_package }} > /dev/null 2>&1; then
    _log "Installe : {{ app.name }}"
else
    _log "ECHEC : {{ app.name }} ({{ app.apt_package }}) non installe - depots injoignables ?"
fi
{% if app.linux_post_install %}
_log "Post-installation : {{ app.name }}"
(
{{ app.linux_post_install }}
) || _log "AVERTISSEMENT : post-installation de {{ app.name }} terminee en erreur"
{% endif %}
{% endfor %}
{% endif %}

{% if zabbix %}
# ── Supervision Zabbix ────────────────────────────────────────────────────────
# Agent en mode ACTIF : c'est lui qui sort vers le collecteur en TCP 10051.
# Le VLAN est isole, rien n'entre — le collecteur ne joint jamais la machine.
_log "Supervision Zabbix : agent actif vers {{ zabbix.server }}"
# Non fatal, et DIT. Un VLAN serveur qui ne sort pas est la norme, pas une panne :
# les depots sont alors injoignables, et ce qui suit se debrouille avec ce qui est
# deja present (souvent grave dans le gabarit, sinon servi par OSIRIS). Laisser
# cette commande nue faisait declencher le piege ERR et marquait en echec un
# deploiement par ailleurs parfaitement reussi — constate le 17/09.
apt-get update -qq || _log "AVERTISSEMENT : depots injoignables - on poursuit avec le cache local"
# D'abord les depots de la distribution (Debian fournit encore l'agent), puis le
# paquet servi par OSIRIS. Aucun depot tiers n'est ajoute a la machine.
_zbx_pkg=""
for _p in zabbix-agent2 zabbix-agent; do
    if apt-get install -y "$_p" > /dev/null 2>&1; then _zbx_pkg="$_p"; break; fi
done
if [ -z "$_zbx_pkg" ]; then
    # Ubuntu 24.04 « noble » ne fournit PLUS d'agent Zabbix : le paquet a ete
    # retire des depots (verifie le 2026-08-05, seul `pcp-export-zabbix-agent`
    # subsiste). On sert donc le .deb depuis OSIRIS, exactement comme le MSI
    # WithSecure et le zip DellBIOSProvider cote Windows : aucune VM n'a besoin
    # de joindre repo.zabbix.com depuis le reseau du client, souvent filtre.
    # Les dependances, elles, viennent des depots de la distribution.
    _zbx_deb=/tmp/osiris-zabbix-agent.deb
    _log "Agent absent des depots de la distribution - recuperation depuis OSIRIS..."
    if curl -sf -o "$_zbx_deb" --max-time 120 \
            "$osiris_url/static/installers/zabbix-agent2.deb" \
       && apt-get install -y "$_zbx_deb" > /dev/null 2>&1; then
        _zbx_pkg="zabbix-agent2"
        _log "Agent Zabbix installe depuis OSIRIS."
    else
        _log "AVERTISSEMENT : agent Zabbix introuvable, ni dans les depots ni sur OSIRIS"
        _log "  -> deposer le paquet dans backend/static/installers/zabbix-agent2.deb (voir README)"
    fi
    rm -f "$_zbx_deb"
fi
if [ -n "$_zbx_pkg" ]; then
    if [ "$_zbx_pkg" = "zabbix-agent2" ]; then
        _zbx_dir=/etc/zabbix/zabbix_agent2.d; _zbx_svc=zabbix-agent2
    else
        _zbx_dir=/etc/zabbix/zabbix_agentd.conf.d; _zbx_svc=zabbix-agent
    fi
    mkdir -p "$_zbx_dir"
    # Fichier a part plutot que modification du conf principal : une mise a jour
    # du paquet ne l'ecrase pas, et il est lu par l'Include= par defaut.
    cat > "$_zbx_dir/osiris.conf" << 'ZBXEOF'
# Genere par OSIRIS au premier demarrage - ne pas editer a la main
Server={{ zabbix.server }}
ServerActive={{ zabbix.server }}
Hostname={{ zabbix.hostname }}
HostMetadata={{ zabbix.metadata }}
ZBXEOF
    systemctl enable "$_zbx_svc" > /dev/null 2>&1 || true
    systemctl restart "$_zbx_svc" || _log "AVERTISSEMENT : demarrage de $_zbx_svc en echec"
    _log "Agent Zabbix configure ($_zbx_pkg) - hote : {{ zabbix.hostname }}"
fi
{% endif %}

{% if profile.join_domain and profile.domain and profile.domain_join_user and profile.domain_join_password %}
_log "Jonction au domaine AD : {{ profile.domain }}"

apt-get install -y realmd sssd sssd-tools adcli krb5-user samba-common-bin \
    libnss-sss libpam-sss packagekit 2>&1 | tail -3

# Configuration Kerberos minimale pour la decouverte du domaine
cat > /etc/krb5.conf << 'KRBEOF'
[libdefaults]
    default_realm = {{ profile.domain | upper }}
    dns_lookup_realm = true
    dns_lookup_kdc = true
KRBEOF

# Jonction au domaine
{% if machine.ou %}
printf '%s' {{ profile.domain_join_password | bash_squote }} | realm join \
    --user={{ profile.domain_join_user | bash_squote }} \
    --computer-ou={{ machine.ou | bash_squote }} \
    {{ profile.domain }} 2>&1
{% else %}
printf '%s' {{ profile.domain_join_password | bash_squote }} | realm join \
    --user={{ profile.domain_join_user | bash_squote }} \
    {{ profile.domain }} 2>&1
{% endif %}

if realm list 2>/dev/null | grep -q "{{ profile.domain }}"; then
    _log "Jonction AD reussie"

    # Login sans suffixe @domaine (utilisateur au lieu de utilisateur@domain.local)
    sed -i 's/use_fully_qualified_names = True/use_fully_qualified_names = False/' /etc/sssd/sssd.conf

    # Creation automatique du dossier home au premier login
    echo "session optional pam_mkhomedir.so skel=/etc/skel umask=0077" >> /etc/pam.d/common-session

    # Domain Admins en sudo sans mot de passe
    echo '%domain\ admins ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/domain-admins
    chmod 440 /etc/sudoers.d/domain-admins

    systemctl restart sssd

    _log "Connexion AD disponible - login : utilisateur (sans @{{ profile.domain }})"
else
    _log "ECHEC jonction AD - verifier que le DNS resout {{ profile.domain }} et que les identifiants sont corrects"
fi
{% endif %}

{% if profile.default_user %}
# ── Compte local et acces SSH ─────────────────────────────────────────────────
# Le compte existe deja quand la machine sort d'un installeur ou d'un cloud-init
# qui l'a cree. Sur un clone de template, rien ne le garantit — et une VM sans
# compte est HERMETIQUE : ni SSH ni console, plus personne n'entre. On le cree
# donc si besoin, quel que soit le type de machine.
if id -u {{ profile.default_user | bash_squote }} > /dev/null 2>&1; then
    _log "Compte local {{ profile.default_user }} deja present"
else
    useradd -m -s /bin/bash {{ profile.default_user | bash_squote }}
    usermod -aG sudo {{ profile.default_user | bash_squote }} || true
    _log "Compte local {{ profile.default_user }} cree"
fi
# Aucun mot de passe n'est pose sur ce compte (choix OSIRIS : acces par cle
# uniquement). Sans sudo sans mot de passe il serait donc inutilisable — c'est
# exactement ce que font les images cloud pour leur utilisateur par defaut.
printf '%s ALL=(ALL) NOPASSWD:ALL\n' {{ profile.default_user | bash_squote }} \
    > /etc/sudoers.d/osiris-default-user
chmod 440 /etc/sudoers.d/osiris-default-user

{% if profile.ssh_authorized_keys %}
_osiris_home=$(getent passwd {{ profile.default_user | bash_squote }} | cut -d: -f6)
mkdir -p "$_osiris_home/.ssh"
chmod 700 "$_osiris_home/.ssh"
cat > "$_osiris_home/.ssh/authorized_keys" << 'SSHEOF'
{{ profile.ssh_authorized_keys }}
SSHEOF
chmod 600 "$_osiris_home/.ssh/authorized_keys"
chown -R {{ profile.default_user }}:{{ profile.default_user }} "$_osiris_home/.ssh"
# Une cle sans serveur SSH ne sert a rien, et une image minimale peut ne pas en
# avoir : on s'assure qu'il est la ET demarre.
dpkg -s openssh-server > /dev/null 2>&1 || apt-get install -y openssh-server 2>&1 | tail -1
systemctl enable --now ssh > /dev/null 2>&1 || systemctl enable --now sshd > /dev/null 2>&1 || true
_log "Acces SSH par cle ouvert pour {{ profile.default_user }}"
{% endif %}
{% endif %}

{% if profile.set_root_password %}
# ── Mot de passe root de secours ──────────────────────────────────────────────
# Acces CONSOLE de secours, pour le jour ou le reseau ou SSH est tombe. Root
# reste interdit en SSH (cf. durcissement plus bas) : ce mot de passe ne sert
# qu'en local, devant l'hyperviseur ou l'ecran.
# Il est pose SEULEMENT si OSIRIS confirme l'avoir enregistre : dans l'autre
# ordre, un rappel qui echoue laisserait un root dont plus personne n'a le mot
# de passe — pire que pas de mot de passe du tout.
_root_pw=$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 20)
if curl -sf -X POST "$osiris_url/machines/$_osiris_mac/laps-password" \
        -H "Content-Type: application/json" \
        -d "{\"password\":\"$_root_pw\"}" --max-time 15 > /dev/null; then
    echo "root:$_root_pw" | chpasswd
    # Un mot de passe ne suffit pas si le compte est verrouille : les images
    # cloud livrent root avec un « ! » dans /etc/shadow, et selon la version
    # chpasswd ne le retire pas. Sans ce deverrouillage, l'acces console promis
    # par OSIRIS n'existe pas — panne invisible jusqu'au jour ou on en a besoin.
    passwd -u root > /dev/null 2>&1 || true
    _root_state=$(passwd -S root 2>/dev/null | awk '{print $2}')
    _log "Mot de passe root applique - etat du compte : $_root_state"
    _osiris_log "compte root : etat=$_root_state (P=utilisable, L=verrouille, NP=sans mot de passe)"
else
    _log "AVERTISSEMENT : OSIRIS n'a pas confirme l'enregistrement - root reste verrouille"
fi
unset _root_pw
{% endif %}

{% if data_disk_gb %}
# ── Disque de donnees ─────────────────────────────────────────────────────────
# Le second disque est cree vierge par l'hyperviseur : c'est ici qu'il devient
# utilisable. On ne touche QUE a un disque sans table de partition ni systeme de
# fichiers — jamais au disque systeme, jamais a un disque deja formate (on ne
# veut surtout pas ecraser des donnees lors d'un redeploiement).
_log "Recherche du disque de donnees ({{ data_disk_gb }} Go attendus)..."
_root_src=$(findmnt -no SOURCE / 2>/dev/null)
_root_disk=$(lsblk -no PKNAME "$_root_src" 2>/dev/null | head -1)
[ -z "$_root_disk" ] && _root_disk=$(basename "$_root_src" 2>/dev/null)
_data_disk=""
# Filtres, dans l'ordre : type "disk", NON amovible, et au moins 1 Go.
# VMware presente un lecteur de disquettes virtuel /dev/fd0 de 4 Ko que lsblk
# classe comme un disque, sans partition ni systeme de fichiers — donc le profil
# exact de ce qu'on cherche, et il passe avant sdb dans l'ordre alphabetique.
# Sans ce filtre, OSIRIS tentait de formater la disquette.
# Options separees, et surtout PAS `-dnob` : dans un groupe, le `-o` avale le `b`
# comme son argument, lsblk repond « unknown column: b » et n'affiche RIEN. La
# boucle ne tournait donc jamais et /data n'a jamais pu etre configure, sur aucun
# hyperviseur, depuis le premier jour. Le message « aucun disque vierge trouve »
# accusait l'hyperviseur d'un defaut qui etait ici.
for _d in $(lsblk -d -n -b -o NAME,TYPE,RM,SIZE 2>/dev/null \
            | awk '$2=="disk" && $3==0 && $4 > 1073741824 {print $1}'); do
    [ "$_d" = "$_root_disk" ] && continue
    # Vide = ni partition, ni systeme de fichiers, ni membre d'un LVM/RAID
    if [ -z "$(lsblk -no FSTYPE,PARTTYPE "/dev/$_d" 2>/dev/null | tr -d ' \n')" ]; then
        _data_disk="/dev/$_d"
        break
    fi
done
if [ -z "$_data_disk" ]; then
    _log "AVERTISSEMENT : aucun disque vierge trouve - /data non configure"
else
    _log "Disque de donnees : $_data_disk"
    # En LVM plutot qu'un ext4 pose a meme le disque : /data s'agrandit alors a
    # chaud, en ajoutant un disque (pvcreate, vgextend, lvextend -r), sans arret
    # ni copie. lvm2 manque aux images cloud Debian et ne s'installe pas sur un
    # VLAN sans depots : on retombe alors sur l'ext4 direct, et on le DIT.
    # La sortie d'apt est gardee : un « non installable » sans la raison ne
    # se diagnostique pas (vu le 25/09, sur une VM sans agent invite ni acces
    # console). Le verrou peut etre tenu par la mise a jour automatique du
    # premier demarrage : on l'attend jusqu'a deux minutes.
    if ! command -v pvcreate > /dev/null 2>&1 \
       && ! _lvm_apt=$(DEBIAN_FRONTEND=noninteractive apt-get install -y \
                        -o DPkg::Lock::Timeout=120 lvm2 2>&1); then
        _osiris_log "apt lvm2 : $(printf '%s' "$_lvm_apt" | tail -3 | tr '\n' ' ')"
    fi
    if command -v pvcreate > /dev/null 2>&1; then
        if ! _lvm_out=$( { pvcreate -q "$_data_disk" && vgcreate -q vg_data "$_data_disk" \
                           && lvcreate -q -y -l 100%FREE -n data vg_data; } 2>&1 ); then
            _osiris_log "echec LVM sur $_data_disk : ${_lvm_out:-aucune sortie}"
            false   # declenche le piege, la machine reste en echec
        fi
        _data_dev=/dev/vg_data/data
        _log "/data en LVM (vg_data/data) - extensible a chaud"
    else
        _data_dev="$_data_disk"
        _log "AVERTISSEMENT : lvm2 absent et non installable : /data formate sans LVM (non extensible a chaud)"
    fi
    # La sortie d'erreur de mkfs est capturee et renvoyee a OSIRIS : sans elle,
    # un echec ici ne produisait que trois lignes « commande fautive » en
    # cascade, sans jamais dire POURQUOI le formatage avait echoue.
    if ! _mkfs_out=$(mkfs.ext4 -q -L osiris-data "$_data_dev" 2>&1); then
        _osiris_log "echec mkfs sur $_data_dev : ${_mkfs_out:-aucune sortie}"
        _osiris_log "disques vus : $(lsblk -dno NAME,SIZE,TYPE 2>/dev/null | tr '\n' ' ')"
        _osiris_log "detail : $(lsblk -no NAME,FSTYPE,PARTTYPE,MOUNTPOINT 2>/dev/null | tr '\n' ' ')"
        false   # declenche le piege, la machine reste en echec
    fi
    mkdir -p /data
    _data_uuid=$(blkid -s UUID -o value "$_data_dev")
    # Monte par UUID : l'ordre des disques (/dev/sdb) peut changer d'un
    # demarrage a l'autre, l'UUID non.
    if ! grep -q "$_data_uuid" /etc/fstab; then
        printf 'UUID=%s /data ext4 defaults,nofail 0 2\n' "$_data_uuid" >> /etc/fstab
    fi
    # `mountpoint` D'ABORD : le piege ERR marque la machine en echec des qu'une
    # commande non testee renvoie non-zero, et `mount` sur un point deja monte
    # renvoie non-zero. Or un gabarit bien fait porte deja l'entree fstab et son
    # disque : /data y est monte par systemd AVANT que ce script ne tourne.
    # Autrement dit, plus le gabarit est complet, plus surement le deploiement
    # echouait — constate le 17/09 sur le premier clone d'un gabarit propre.
    if mountpoint -q /data; then
        _log "/data deja monte ({{ data_disk_gb }} Go) - monte au demarrage"
    else
        mount /data
        _log "/data monte ({{ data_disk_gb }} Go)"
    fi
fi
{% endif %}

# ── Swap ──────────────────────────────────────────────────────────────────────
# Un fichier et non une partition : il se redimensionne sans repartitionner.
# 2 Go fixes : « la moitie de la RAM » date des machines a 1 Go ; sur un serveur
# a 16 Go, 8 Go de swap ne font que ralentir longtemps avant que le noyau ne
# tue le processus fautif. Rien si un swap est deja actif (gabarit, installeur).
# Jamais fatal : une machine sans swap fonctionne, elle le dit et continue.
if [ -n "$(swapon --noheadings --show 2>/dev/null)" ]; then
    _log "Swap deja actif - inchange"
elif [ "$(df --output=avail -k / 2>/dev/null | tail -1)" -lt $((3 * 1024 * 1024)) ]; then
    _log "AVERTISSEMENT : moins de 3 Go libres sur / : pas de fichier de swap"
elif { fallocate -l 2G /swapfile 2>/dev/null \
       || dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none 2>/dev/null; } \
     && chmod 600 /swapfile && mkswap /swapfile > /dev/null 2>&1 && swapon /swapfile 2>/dev/null; then
    grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
    _log "Swap : fichier de 2 Go actif"
else
    rm -f /swapfile
    _log "AVERTISSEMENT : fichier de swap impossible a activer - la machine tourne sans swap"
fi

{% if profile.machine_type == 'server' %}
_log "Durcissement SSH serveur..."

# Durcissement sshd
sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config
sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
sed -i 's/^#*PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config
grep -q '^PasswordAuthentication' /etc/ssh/sshd_config || echo 'PasswordAuthentication no' >> /etc/ssh/sshd_config
grep -q '^PermitRootLogin' /etc/ssh/sshd_config       || echo 'PermitRootLogin no'       >> /etc/ssh/sshd_config

# Cles d'hote : le scellement les SUPPRIME, expres — sans quoi tous les clones
# partageraient la meme identite SSH, et un vrai intercepteur passerait
# inapercu. Encore faut-il que quelqu'un les regenere.
#
# Sur un clone en cloud-init, c'est cloud-init qui s'en charge. Sur un clone NU
# il n'y a pas de source de donnees, le module ne tourne pas, aucune cle n'est
# generee — et sshd refuse de demarrer. La machine se deploie, se declare
# reussie, et personne ne peut s'y connecter. Constate le 17/09, juste apres
# avoir (correctement) coupe l'heritage des metadonnees du gabarit.
#
# `ssh-keygen -A` ne genere que ce qui manque : sans effet quand cloud-init a
# deja fait le travail, salvateur quand personne ne l'a fait.
ssh-keygen -A >/dev/null 2>&1 || _log "AVERTISSEMENT : generation des cles d'hote SSH en echec"

# Effacer le compteur d'echecs AVANT de relancer.
#
# Sans clefs d'hote, sshd a deja echoue cinq fois pendant le demarrage, et
# systemd a ferme la porte : « start request repeated too quickly ». Le
# `restart` ci-dessous est alors REFUSE — on a beau venir de reparer la cause,
# le service reste mort et la machine injoignable. Constate le 17/09.
systemctl reset-failed ssh sshd 2>/dev/null || true
# Le repertoire de separation de privileges vit dans /run, donc il disparait a
# chaque demarrage et n'est recree que par un lancement reussi. Apres cinq
# echecs, il n'existe pas — et sshd refuse de demarrer sans lui.
mkdir -p /run/sshd && chmod 0755 /run/sshd

systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true
if systemctl is-active --quiet ssh 2>/dev/null || systemctl is-active --quiet sshd 2>/dev/null; then
    _log "SSH : auth par mot de passe desactivee, root interdit"
else
    _log "AVERTISSEMENT : sshd ne demarre pas — la machine sera injoignable en SSH"
fi
{% endif %}

{% if profile.post_script %}
_log "Execution du script post-install du profil..."
(
{{ profile.post_script }}
) || _log "AVERTISSEMENT : Script post-install du profil termine avec une erreur"
_log "Script post-install du profil termine."
{% endif %}

{% if machine.post_script %}
# APRES celui du profil : le profil pose le socle commun a un type de machine,
# ce script-ci ne vaut que pour celle-la. Les deux se cumulent, on ne duplique
# pas un profil entier pour trois lignes.
#
# Sous-shell et erreur non fatale, comme pour le profil : un script de
# personnalisation qui echoue ne doit pas emporter un deploiement par ailleurs
# reussi — mais il se voit dans le journal, qui est le seul temoin sur une
# machine distante.
#
# `_log` et NON `echo` : `echo` n'ecrit que le fichier local, sur une machine
# que personne n'ira consulter. L'avertissement n'atteignait donc jamais OSIRIS,
# et un script rate rendait un journal STRICTEMENT identique a un script reussi.
_log "Execution du script post-install de la machine..."
(
{{ machine.post_script }}
) || _log "AVERTISSEMENT : Script post-install de la machine termine avec une erreur"
_log "Script post-install de la machine termine."
{% endif %}

_log "Premier demarrage OSIRIS termine."

# ── Smoke tests ───────────────────────────────────────────────────────────────
_log "Smoke tests post-deploiement..."
_smoke_json="["
_smoke_first=true

_add_test() {
    local name="$1" ok="$2" detail="${3:-}"
    local ok_val=$([ "$ok" = "true" ] && echo "true" || echo "false")
    local icon=$([ "$ok" = "true" ] && echo "OK" || echo "FAIL")
    local detail_safe=$(echo "$detail" | sed 's/"/\\"/g')
    _log "  [$icon] $name${detail:+ : $detail}"
    [ "$_smoke_first" = "true" ] && _smoke_first=false || _smoke_json+=","
    _smoke_json+="{\"name\":\"$(echo "$name" | sed 's/"/\\"/g')\",\"ok\":$ok_val,\"detail\":\"$detail_safe\"}"
}

# Resolution DNS - mesuree AVANT de juger la passerelle : une resolution qui
# aboutit sort du reseau, donc elle prouve le routage a elle seule.
if getent hosts www.google.com > /dev/null 2>&1; then _dns_ok=true; else _dns_ok=false; fi

# L'adresse REELLE correspond-elle a celle de la fiche ?
#
# Test ajoute le 17/09 apres une VM deployee, verte partout, qui tournait sur une
# adresse DHCP alors que sa fiche en annoncait une fixe : l'image livrait
# `network: {config: disabled}`, donc le nom d'hote injecte a ete applique et le
# reseau ignore. Rien ne l'a signale.
#
# C'est le pire cas de tous : la machine marche. Elle repond, elle se supervise,
# elle passe tous les autres tests — et l'inventaire ment. La prochaine personne
# qui cherchera ce serveur a l'adresse ecrite dans OSIRIS ne trouvera personne,
# ou pire, trouvera quelqu'un d'autre.
#
# On compare l'ADRESSE seule, pas le prefixe : c'est elle qui sert a joindre la
# machine, et un /24 ecrit /25 par erreur ne justifie pas de crier au loup.
{% if ip_attendue %}
_ip_attendue="{{ ip_attendue }}"
_ip_reelles=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
if printf '%s\n' $_ip_reelles | grep -qx "$_ip_attendue"; then
    _add_test "Adresse conforme a la fiche" true "$_ip_attendue"
else
    _add_test "Adresse conforme a la fiche" false \
        "fiche : $_ip_attendue - reel : $(printf '%s' $_ip_reelles | tr '\n' ' ')"
fi
{% endif %}

# Ping passerelle par defaut.
#
# Une passerelle qui ne repond pas a l'ICMP est la NORME des qu'elle est portee par
# un pare-feu. La declarer en panne alors que le trafic passe produit une alarme
# permanente sur une machine saine - et une alarme permanente cesse d'etre lue, ce
# qui coute bien plus cher que le test ne rapporte. On ne conclut donc a la panne
# que si rien d'autre ne prouve le routage.
_gw=$(ip route show default 2>/dev/null | awk '{print $3}' | head -1)
if [ -z "$_gw" ]; then
    _add_test "Passerelle" false "Aucune route par defaut"
elif ping -c 1 -W 3 "$_gw" > /dev/null 2>&1; then
    _add_test "Ping passerelle ($_gw)" true
elif [ "$_dns_ok" = "true" ]; then
    _add_test "Ping passerelle ($_gw)" true "ICMP filtre - routage prouve par la resolution DNS"
else
    _add_test "Ping passerelle" false "Passerelle inatteignable"
fi

if [ "$_dns_ok" = "true" ]; then
    _add_test "Resolution DNS" true
else
    _add_test "Resolution DNS" false "Echec DNS"
fi

{% if profile.ntp_servers %}
# Source de temps REELLEMENT retenue par le systeme, pas celle qu'on a demandee.
# L'ecart d'horloge est une dependance dure de Kerberos : au-dela de cinq minutes,
# la jonction au domaine et toute authentification AD echouent, avec des messages
# qui ne parlent jamais d'heure. Une machine qui derive est donc une panne AD en
# preparation, et rien d'autre ne la signale.
#
# Le verdict porte sur la presence d'une source active (deterministe des le
# demarrage) et non sur l'etat de synchronisation, qui peut demander plus de temps
# que les quelques secondes ecoulees ici : un test qui echouerait une fois sur deux
# sur une machine saine cesserait vite d'etre lu.
_ntp_src=$(timedatectl show-timesync --property=ServerName --value 2>/dev/null)
[ -z "$_ntp_src" ] && _ntp_src=$(chronyc -n sources 2>/dev/null | awk '/^\^\*/{print $2}' | head -1)
_ntp_sync=$(timedatectl show --property=NTPSynchronized --value 2>/dev/null)
if [ -n "$_ntp_src" ]; then
    _add_test "Serveur de temps" true "$_ntp_src (synchronise : ${_ntp_sync:-inconnu})"
else
    _add_test "Serveur de temps" false "aucune source de temps active"
fi
{% endif %}

# Acces internet reel, pas seulement DNS : un resolveur peut repondre sans que le
# trafic HTTPS ne sorte derriere - un pare-feu peut filtrer le port 443 plus
# strictement qu'il ne filtre le DNS. curl est deja garanti present : c'est lui
# qui a recupere ce script au demarrage de la machine.
if curl -fsS -m 5 -o /dev/null https://www.google.com; then
    _add_test "Acces internet (HTTPS)" true
else
    _add_test "Acces internet (HTTPS)" false "https://www.google.com injoignable en HTTPS"
fi

{% if profile.join_domain %}
# Jonction domaine AD
if realm list 2>/dev/null | grep -q "{{ profile.domain }}"; then
    _add_test "Jonction domaine AD" true "{{ profile.domain }}"
else
    _add_test "Jonction domaine AD" false "Domaine non trouve dans realm list"
fi
{% endif %}

{% if profile.machine_type == 'server' %}
# Service SSH
if systemctl is-active --quiet ssh 2>/dev/null || systemctl is-active --quiet sshd 2>/dev/null; then
    _add_test "Service SSH" true "En cours d'execution"
else
    _add_test "Service SSH" false "Service SSH inactif"
fi

# Auth par mot de passe desactivee
if grep -qE '^PasswordAuthentication\s+no' /etc/ssh/sshd_config 2>/dev/null; then
    _add_test "SSH - auth mot de passe" true "Desactivee"
else
    _add_test "SSH - auth mot de passe" false "Toujours active"
fi
{% else %}
# Service TeamViewer
if systemctl is-active --quiet teamviewerd 2>/dev/null; then
    _add_test "TeamViewer" true "En cours d'execution"
else
    _add_test "TeamViewer" false "Service inactif ou absent"
fi
{% endif %}

{% if zabbix %}
# Agent de supervision
if systemctl is-active --quiet zabbix-agent2 2>/dev/null || systemctl is-active --quiet zabbix-agent 2>/dev/null; then
    _add_test "Agent Zabbix" true "Actif - hote {{ zabbix.hostname }}"
else
    _add_test "Agent Zabbix" false "Service inactif ou absent"
fi

# Joignabilite du collecteur : teste la regle de pare-feu, pas seulement l'agent.
# C'est le seul moyen de distinguer « agent mal configure » de « flux bloque ».
if timeout 3 bash -c "</dev/tcp/{{ zabbix.server }}/10051" 2>/dev/null; then
    _add_test "Collecteur Zabbix joignable" true "{{ zabbix.server }}:10051"
else
    _add_test "Collecteur Zabbix joignable" false "TCP 10051 ferme vers {{ zabbix.server }} (regle pare-feu ?)"
fi
{% endif %}

{% if data_disk_gb %}
# Volume de donnees : jusqu'ici son montage n'etait verifie par rien. On en
# deduisait le succes de l'absence d'erreur, ce qui n'est pas la meme chose.
if mountpoint -q /data 2>/dev/null; then
    _add_test "Volume /data" true "$(df -h /data 2>/dev/null | awk 'NR==2{print $2}') disponibles"
else
    _add_test "Volume /data" false "Non monte"
fi
{% endif %}

_swap_taille=$(swapon --noheadings --show=SIZE 2>/dev/null | head -1 | tr -d ' ')
if [ -n "$_swap_taille" ]; then
    _add_test "Swap" true "$_swap_taille"
else
    _add_test "Swap" false "Aucun swap actif"
fi

{% if linux_apps %}
# Presence REELLE des paquets demandes. Ce bloc bouclait sur `ubuntu_packages`,
# une variable qu'aucun appelant n'a jamais passee : le controle ne s'executait
# donc jamais, sur aucune machine, et une installation ratee passait inapercue.
{% for app in linux_apps %}
if dpkg -s "{{ app.apt_package }}" > /dev/null 2>&1; then
    _add_test "Paquet : {{ app.name }}" true
else
    _add_test "Paquet : {{ app.name }}" false "{{ app.apt_package }} non installe"
fi
{% endfor %}
{% endif %}

# Acces a la machine - mesure sur la machine, pas deduit du profil.
# Un profil sans cle, sans domaine et sans mot de passe de secours deployait une
# machine ou personne ne pouvait entrer, et OSIRIS ecrivait « reussi ». Le profil
# ne sait pas tout : le gabarit peut apporter ses propres comptes, une cle peut
# etre mal collee. On compte donc ce qui existe VRAIMENT, et zero porte d'entree
# est un echec du deploiement, pas un avertissement.
# Coutures OSIRIS_PASSWD / OSIRIS_HOME_RACINE : relire le controle en test sans
# toucher aux comptes de la machine qui fait tourner les tests.
_portes_d_entree() {
    local _ssh_actif=false _portes=""
    if systemctl is-active --quiet ssh 2>/dev/null || systemctl is-active --quiet sshd 2>/dev/null; then
        _ssh_actif=true
    fi
    # Root interdit en SSH (durcissement serveur) : sa cle n'ouvre rien
    local _root_ssh=true
    grep -qiE '^[[:space:]]*PermitRootLogin[[:space:]]+no' "${OSIRIS_SSHD_CONFIG:-/etc/ssh/sshd_config}" 2>/dev/null \
        && _root_ssh=false
    while IFS=: read -r _u _x _uid _gid _gecos _home _shell; do
        case "$_shell" in */nologin|*/false|"") continue ;; esac
        _home="${OSIRIS_HOME_RACINE:-}$_home"
        # Une cle ne compte que si elle ouvre un shell : serveur SSH actif, root
        # autorise s'il s'agit de root, et pas d'option `command=`. Les images
        # cloud posent chez root une cle reduite a « connectez-vous avec
        # l'utilisateur… » : elle se voit, elle n'ouvre rien. Vu le 18/09.
        if [ "$_ssh_actif" = true ] && { [ "$_uid" != 0 ] || [ "$_root_ssh" = true ]; } \
                && [ -f "$_home/.ssh/authorized_keys" ] \
                && grep -vE '^[[:space:]]*(#|$)' "$_home/.ssh/authorized_keys" 2>/dev/null \
                   | grep -qvE '(^|,)command="'; then
            _portes="$_portes cle SSH ($_u),"
        fi
        # P = mot de passe utilisable ; L (verrouille) et NP (vide) ne sont pas des portes
        if [ "$(passwd -S "$_u" 2>/dev/null | awk '{print $2}')" = "P" ]; then
            _portes="$_portes mot de passe ($_u),"
        fi
    done < "${OSIRIS_PASSWD:-/etc/passwd}"
    if realm list --name-only 2>/dev/null | grep -q .; then
        _portes="$_portes domaine,"
    fi
    printf '%s' "${_portes%,}"
}
_acces=$(_portes_d_entree)
if [ -n "$_acces" ]; then
    _add_test "Acces a la machine" true "${_acces# }"
else
    _add_test "Acces a la machine" false "aucune cle SSH, aucun mot de passe utilisable, aucun domaine : personne ne peut entrer"
    _log "ECHEC : machine inaccessible - ajouter une cle SSH ou le mot de passe root de secours au profil, puis redeployer"
    if [ "$_osiris_failed" -eq 0 ]; then
        curl -s -X POST "$osiris_url/machines/$_osiris_mac/status?status=failed" --max-time 10 > /dev/null || true
        _osiris_failed=1
    fi
fi

_smoke_json+="]"

# Envoi du rapport a OSIRIS
_smoke_body="{\"tests\":${_smoke_json}}"
if curl -s -X POST "$osiris_url/machines/$_osiris_mac/smoke-tests" \
    -H "Content-Type: application/json" \
    -d "$_smoke_body" --max-time 15; then
    _log "Rapport smoke tests envoye."
else
    _log "AVERTISSEMENT : Echec envoi rapport smoke tests."
fi

# Fin reelle du deploiement. Sur le chemin PXE, l'installeur a deja poste
# « deployed » avant le reboot ; ici c'est le firstboot qui fait foi, et sur le
# chemin cloud-init (clone de template) c'est le SEUL signal de fin.
# On n'annonce « deployed » que si RIEN n'a echoue. Sinon le statut d'echec
# deja poste reste en place : annoncer un succes apres coup masquerait le probleme.
if [ "$_osiris_failed" -eq 0 ]; then
    curl -s -X POST "$osiris_url/machines/$_osiris_mac/status?status=deployed" --max-time 15 > /dev/null || true
    _log "Deploiement signale comme reussi."
else
    _log "Des erreurs ont eu lieu - la machine reste en echec cote OSIRIS."
fi

# L'unite n'existe que sur le chemin PXE : sur le chemin cloud-init, le script
# est lance directement par runcmd. Sans le `|| true`, cet echec de fin
# declenchait le piege d'erreur APRES le « deployed » et le transformait en echec.
systemctl disable osiris-firstboot.service 2>/dev/null || true
