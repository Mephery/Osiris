@echo off
setlocal

set MAC={{ mac }}
set OSIRIS={{ osiris_url }}
set OSIRIS_IP={{ osiris_ip }}

echo [OSIRIS] ===== Deploiement Windows =====
echo [OSIRIS] Machine : {{ machine.hostname }} ({{ machine.client }})
echo [OSIRIS] MAC     : %MAC%
X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Demarrage+deploiement+{{ machine.hostname }}" >nul 2>&1

REM ── Partitionnement GPT (UEFI) ────────────────────────────────────────────
REM La partition Windows est montee en W: et NON en C: pendant WinPE : sur
REM certaines machines, C: est deja pris (disque virtuel de wimboot, volume
REM residuel...) et "assign letter=C" echoue avec "La lettre de lecteur
REM specifiee n'est pas libre", ce qui fait ensuite planter DISM en erreur 21
REM ("Le peripherique n'est pas pret") puisqu'il applique dans le vide.
REM Apres le redemarrage, cette partition devient C: normalement : les chemins
REM de l'unattend (C:\osiris-firstboot.ps1) restent donc bien en C:.
echo [OSIRIS] Partitionnement du disque (GPT/UEFI)...
X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Partitionnement+GPT+en+cours..." >nul 2>&1
(
echo select disk 0
echo clean
echo convert gpt
echo create partition efi size=512
echo format quick fs=fat32 label=System
echo assign letter=S
echo create partition msr size=16
echo create partition primary
echo format quick fs=ntfs label=Windows
echo assign letter=W
) > X:\diskpart.txt
diskpart /s X:\diskpart.txt
if errorlevel 1 (
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=ERREUR+diskpart+!" >nul 2>&1
    echo [OSIRIS] ERREUR diskpart !
    pause
    exit /b 1
)
X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/deploy-progress?p=10" >nul 2>&1
X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Partitionnement+OK+(EFI+512MB+MSR+16MB+Windows+NTFS)" >nul 2>&1

REM ── Connexion au partage Windows ──────────────────────────────────────────
echo [OSIRIS] Connexion au partage reseau SMB...
X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Connexion+SMB+en+cours..." >nul 2>&1
REM Retry du montage : un error 53 passager (pile reseau, session zombie serveur)
REM ne doit pas faire echouer le deploiement.
set SMBTRY=0
:smbz_retry
net use Z: /delete /y >nul 2>&1
net use Z: \\%OSIRIS_IP%\windows /user:guest "" 2>nul
if not errorlevel 1 goto smbz_ok
set /a SMBTRY+=1
if %SMBTRY% lss 8 (
    echo [OSIRIS] Montage SMB echoue - nouvelle tentative %SMBTRY%/8...
    ping -n 6 127.0.0.1 >nul
    goto smbz_retry
)
X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=ERREUR+connexion+SMB+apres+8+tentatives" >nul 2>&1
echo [OSIRIS] ERREUR : impossible de se connecter au partage SMB !
pause
exit /b 1
:smbz_ok
X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Partage+SMB+monte+OK" >nul 2>&1

REM ── Detection de l'image ──────────────────────────────────────────────────
{% if profile.win_image %}
set WIM=Z:\{{ profile.win_image }}
if not exist %WIM% (
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=ERREUR+:+{{ profile.win_image }}+introuvable+!" >nul 2>&1
    echo [OSIRIS] ERREUR : {{ profile.win_image }} introuvable sur le partage SMB !
    pause
    exit /b 1
)
X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Golden+image+:+{{ profile.win_image }}" >nul 2>&1
{% else %}
if exist Z:\install.wim (
    set WIM=Z:\install.wim
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Image+trouvee+:+install.wim" >nul 2>&1
) else if exist Z:\install.esd (
    set WIM=Z:\install.esd
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Image+trouvee+:+install.esd" >nul 2>&1
) else (
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=ERREUR+:+install.wim+introuvable+!" >nul 2>&1
    echo [OSIRIS] ERREUR : install.wim introuvable sur le partage !
    pause
    exit /b 1
)
{% endif %}

REM ── Application de l'image Windows ───────────────────────────────────────
echo [OSIRIS] Application de l'image Windows (patience - 15 a 30 min)...
X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/deploy-progress?p=15" >nul 2>&1
X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=DISM+en+cours+(15-30+min)..." >nul 2>&1
dism /Apply-Image /ImageFile:%WIM% /Index:{{ win_index }} /ApplyDir:W:\
if errorlevel 1 (
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=ERREUR+DISM+!" >nul 2>&1
    echo [OSIRIS] ERREUR DISM !
    pause
    exit /b 1
)
X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/deploy-progress?p=85" >nul 2>&1
REM `%%25` et non `%25` : dans un .cmd, cmd.exe consomme `%2` comme paramètre du
REM script et il ne reste que le `5` — le journal affichait « DISM 1005 OK ».
X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=DISM+100%%25+OK" >nul 2>&1

REM ── Injection de drivers constructeurs ───────────────────────────────────
REM {{ driver_dir }} = "" (rien a injecter : VM) | "drivers" (tout le dossier)
REM                  | "drivers\<vendor>\<key>" (pack cible)
{% if not driver_dir %}
REM Materiel virtuel : les pilotes sont inbox. Injecter le dossier complet ici
REM coutait des heures de DISM pour du materiel qui n'existe pas.
X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=VM+:+pilotes+constructeurs+inutiles+(materiel+virtuel+standard)" >nul 2>&1
echo [OSIRIS] VM - injection de drivers ignoree ^(pilotes inbox^)
{% else %}
echo [OSIRIS] Recherche de drivers constructeurs sur le partage...
REM Chemin SANS guillemets : model_key n'a jamais d'espace, et un chemin quote
REM finissant par \" casse le parsing DISM (le \ echappe le guillemet fermant).
if exist Z:\{{ driver_dir }}\ (
    echo [OSIRIS] Injection de drivers depuis Z:\{{ driver_dir }}\...
    REM Le dossier retenu part dans le journal : sans lui, verifier quel pack a ete
    REM injecte oblige a rejouer _resolve_driver_dir sur la fiche (fait a la main le
    REM 04/08). Antislashs remplaces par des slashs : le journal passe par une URL, et
    REM un %5C dans un .cmd serait mange par l'expansion des parametres du batch.
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Injection+drivers+depuis+Z:/{{ driver_dir | replace('\\', '/') }}" >nul 2>&1
    dism /Image:W:\ /Add-Driver /Driver:Z:\{{ driver_dir }}\ /Recurse /ForceUnsigned
    if errorlevel 1 (
        X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Avertissement+:+certains+drivers+KO+(non+bloquant)" >nul 2>&1
        echo [OSIRIS] AVERTISSEMENT : certains drivers n'ont pas pu etre injectes ^(non bloquant^)
    ) else (
        X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Drivers+injectes+avec+succes" >nul 2>&1
        echo [OSIRIS] Drivers injectes avec succes
    )
) else (
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Aucun+dossier+drivers+(etape+ignoree)" >nul 2>&1
    echo [OSIRIS] Aucun dossier drivers sur le partage - etape ignoree
)
{% endif %}

REM ── Configuration du demarrage UEFI ──────────────────────────────────────
echo [OSIRIS] Configuration du boot UEFI...
X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=bcdboot+UEFI+en+cours..." >nul 2>&1
bcdboot W:\Windows /l {{ locale }} /s S: /f UEFI
if errorlevel 1 (
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Avertissement+bcdboot+(non+bloquant)" >nul 2>&1
    echo [OSIRIS] AVERTISSEMENT bcdboot ^(non bloquant^)
) else (
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=bcdboot+UEFI+OK" >nul 2>&1
)
bcdedit /store S:\EFI\Microsoft\Boot\BCD /set {bootmgr} timeout 0
X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/deploy-progress?p=92" >nul 2>&1

REM ── Unattend.xml : personnalisation OOBE ─────────────────────────────────
echo [OSIRIS] Telechargement de unattend.xml...
mkdir W:\Windows\Panther 2>nul
X:\curl.exe -sf -k -o W:\Windows\Panther\unattend.xml "http://%OSIRIS_IP%/unattend.xml?mac=%MAC%" 2>nul
if exist W:\Windows\Panther\unattend.xml (
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=unattend.xml+installe" >nul 2>&1
    echo [OSIRIS] unattend.xml installe
) else (
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Avertissement+:+unattend.xml+manquant" >nul 2>&1
    echo [OSIRIS] AVERTISSEMENT : unattend.xml non disponible ^(OOBE non automatisee^)
)

REM ── Config pour le premier demarrage ────────────────────────────────────
echo OSIRIS_URL=%OSIRIS% > W:\osiris.cfg
{% if profile.tv_suffix %}echo TV_SUFFIX={{ profile.tv_suffix }} >> W:\osiris.cfg{% endif %}

REM ── Script de post-deploiement (premier demarrage) ────────────────────────
echo [OSIRIS] Telechargement du script de premier demarrage...
X:\curl.exe -sf -k -o W:\osiris-firstboot.ps1 "http://%OSIRIS_IP%/firstboot-windows/%MAC%" 2>nul
if exist W:\osiris-firstboot.ps1 (
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=firstboot.ps1+installe" >nul 2>&1
    echo [OSIRIS] osiris-firstboot.ps1 installe
) else (
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Avertissement+:+firstboot.ps1+manquant" >nul 2>&1
    echo [OSIRIS] AVERTISSEMENT : osiris-firstboot.ps1 non disponible
)

REM ── Notification OSIRIS ───────────────────────────────────────────────────
echo [OSIRIS] Notification du serveur (statut : deployed)...
X:\curl.exe -sf -k -X POST "http://%OSIRIS_IP%/machines/%MAC%/status?status=deployed" 2>nul
if errorlevel 1 (
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Avertissement+:+callback+deployed+echoue" >nul 2>&1
    echo [OSIRIS] ^(avertissement : callback echoue, ignoré^)
) else (
    X:\curl.exe -sf -X POST "http://%OSIRIS_IP%/machines/%MAC%/log?msg=Statut+deployed+confirme+-+reboot+dans+10s" >nul 2>&1
    echo [OSIRIS] Statut mis a jour : deployed
)

echo [OSIRIS] ===== Image installee ! Redemarrage dans 10s =====
ping -n 11 127.0.0.1 >nul
wpeutil reboot
