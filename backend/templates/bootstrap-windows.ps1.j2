<#
==============================================================================
 OSIRIS - Installation du mecanisme d'amorcage generique (Windows)

 A executer UNE SEULE FOIS, en administrateur, sur la VM qui servira de
 template, AVANT le sysprep :

     irm {{ osiris_url }}/bootstrap/windows | iex

 Puis, juste avant de sceller (ecrit le fichier de reponses et lance sysprep) :

     & ([scriptblock]::Create((irm {{ osiris_url }}/bootstrap/windows))) -Seal

 Ajouter -ProductKey XXXXX-XXXXX-XXXXX-XXXXX-XXXXX pour graver une cle dans le
 gabarit. Sans elle, Windows demarre non active et la page qui la reclame - qui
 arreterait l'OOBE de chaque clone - n'est pas affichee.

 Ce qu'il installe ne contient AUCUN identifiant et AUCUNE logique metier :
 juste « lis ta MAC, demande ton script a OSIRIS, execute-le ». Tout le reste
 (profil, applications, jonction au domaine, supervision, BitLocker, LAPS) est
 decide par OSIRIS au demarrage de chaque clone. Consequence : on ne refabrique
 PAS le template quand un profil change - seulement si ce mecanisme-ci evolue,
 c'est-a-dire quasiment jamais.

 Pendant du `bootstrap/linux`, avec deux differences imposees par Windows :
 le declencheur est l'ouverture de session automatique du fichier de reponses
 (le firstboot d'OSIRIS a besoin d'une session `osiris-admin`, pas de SYSTEM),
 et le scellement passe par sysprep au lieu d'un vidage de machine-id.
==============================================================================
#>
param(
    [string] $OsirisUrl = "{{ osiris_url }}",
    # Ecrit le fichier de reponses generique et lance sysprep. A ne faire qu'une
    # fois tout le reste pret : la VM s'eteint et ne doit PLUS etre redemarree
    # avant d'avoir ete convertie en template.
    [switch] $Seal,
    # NECESSAIRE sur un support sous licence : sans clef, l'OOBE de chaque clone
    # s'arrete sur « entrez votre cle » et attend un humain - donc pas de session
    # automatique, pas d'amorcage, aucun rappel. Il n'existe AUCUNE directive
    # d'unattend pour masquer cette page (essaye et constate le 21/08 : la passe
    # oobeSystem entiere devient invalide).
    # Y mettre la KMS client setup key (GVLK) de l'edition : clef PUBLIQUE de
    # Microsoft, qui n'active rien et ne consomme aucune licence - elle laisse
    # juste passer l'OOBE. Le client pose ensuite la sienne avec `slmgr /ipk`.
    [string] $ProductKey = ""
)

$ErrorActionPreference = "Stop"

# Pas de `#Requires -RunAsAdministrator` : cette directive n'est valable que dans
# un fichier .ps1, or ce script est concu pour etre execute via `irm | iex`, ou
# elle leverait une erreur. On verifie donc les droits nous-memes.
$estAdmin = ([Security.Principal.WindowsPrincipal] `
    [Security.Principal.WindowsIdentity]::GetCurrent()
).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if (-not $estAdmin) {
    throw "A executer dans un terminal PowerShell ADMINISTRATEUR."
}
$dossierProg = "C:\Program Files\OSIRIS"
$dossierData = "C:\ProgramData\OSIRIS"
$reponses    = "C:\Windows\Panther\unattend-osiris.xml"

Write-Host "[OSIRIS] Serveur : $OsirisUrl"

New-Item -ItemType Directory -Force -Path $dossierProg, $dossierData | Out-Null

# Seule donnee propre a l'installation : l'URL d'OSIRIS. Ce n'est pas un secret.
Set-Content -Path "$dossierData\bootstrap.conf" -Encoding ASCII `
            -Value "OSIRIS_URL=$OsirisUrl"

# ── Le script d'amorcage lui-meme ────────────────────────────────────────────
# Identique sur toutes les machines : ni secret, ni configuration, ni metier.
$amorcage = @'
<#
 OSIRIS - Amorcage du premier demarrage. Generique : ce fichier est identique
 sur toutes les machines. Il decouvre sa propre MAC, demande son script de
 premier demarrage a OSIRIS, et l'execute.
#>
$ErrorActionPreference = "Continue"
$dossierData = "C:\ProgramData\OSIRIS"
$journal     = "C:\osiris-bootstrap.log"
$verrou      = "$dossierData\firstboot-en-cours.marker"

function Ecrire($msg) {
    $ligne = "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') $msg"
    Write-Host $ligne
    Add-Content -Path $journal -Value $ligne -ErrorAction SilentlyContinue
}

# Deux declencheurs existent (session automatique du fichier de reponses, et la
# tache planifiee de secours). Ils peuvent se chevaucher au tout premier
# demarrage : sans ce verrou, le firstboot tournerait DEUX FOIS en parallele.
if (Test-Path $verrou) {
    $age = (Get-Date) - (Get-Item $verrou).LastWriteTime
    if ($age.TotalHours -lt 2) {
        Ecrire "Un premier demarrage est deja en cours (marqueur de $([int]$age.TotalMinutes) min) - abandon."
        exit 0
    }
    Ecrire "Marqueur perime ($([int]$age.TotalHours) h) - on reprend."
}

$OsirisUrl = ""
if (Test-Path "$dossierData\bootstrap.conf") {
    $ligne = Select-String -Path "$dossierData\bootstrap.conf" -Pattern '^OSIRIS_URL=(.+)$'
    if ($ligne) { $OsirisUrl = $ligne.Matches.Groups[1].Value.Trim() }
}
if (-not $OsirisUrl) {
    Ecrire "Aucune URL OSIRIS dans bootstrap.conf - abandon."
    exit 1
}
Ecrire "===== Amorcage OSIRIS - serveur $OsirisUrl ====="

# ── Adressage fourni par l'hyperviseur ───────────────────────────────────────
# Un sysprep remet la carte reseau en DHCP. Sur un VLAN serveur qui n'en a pas,
# le clone se rabat sur une adresse 169.254.x.x, tourne parfaitement... et ne
# joint personne, donc pas meme OSIRIS qui porte tout le reste. Il faut donc
# qu'il sache s'adresser AVANT d'avoir un reseau : VMware Tools lit la
# configuration de la VM sans passer par le reseau, c'est la seule voie.
# Constate le 21/08 sur le premier clone Windows du vCenter.
#
# On ne touche a rien des qu'une adresse utilisable existe : sur un reseau avec
# DHCP, le bail fait le travail, et ecraser une configuration qui marche serait
# le meilleur moyen de casser ce qu'on essaie de reparer. Rejouable tel quel.
function AdresseUtilisable {
    Get-NetIPAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue |
        Where-Object { $_.IPAddress -notlike "169.254.*" -and $_.IPAddress -ne "127.0.0.1" }
}

function CheminVmtoolsd {
    @("C:\Program Files\VMware\VMware Tools\vmtoolsd.exe",
      "C:\Program Files (x86)\VMware\VMware Tools\vmtoolsd.exe") |
        Where-Object { Test-Path $_ } | Select-Object -First 1
}

function InfoGet($cle) {
    # Plusieurs candidats plutot que $env:ProgramFiles seul : dans un processus
    # 32 bits cette variable vaut "C:\Program Files (x86)", et l'outil serait
    # declare absent alors qu'il est installe. On chercherait alors une panne de
    # VMware Tools la ou il n'y a qu'une console mal choisie.
    #
    # Chaque sortie a vide DIT pourquoi. Premiere version : les trois causes
    # (outil absent, commande en echec, valeur vide) rendaient le meme "" et le
    # journal disait "aucun adressage fourni" dans les trois cas. Il a fallu une
    # console pour trancher ce que le journal aurait du dire - exactement le
    # genre de panne muette que ce projet passe son temps a supprimer ailleurs.
    $exe = CheminVmtoolsd
    if (-not $exe) {
        Ecrire "  guestinfo : vmtoolsd introuvable."
        return ""
    }
    $valeur = ""
    try {
        $valeur = ("" + (& $exe --cmd "info-get $cle" 2>$null)).Trim()
    } catch {
        Ecrire "  guestinfo : $cle - lancement de vmtoolsd impossible : $_"
        return ""
    }
    $code = $LASTEXITCODE
    if ($code -ne 0) {
        # Relance en capturant le message : la premiere passe le jette pour ne
        # pas polluer la valeur, mais en echec c'est lui qui porte la cause.
        $detail = ("" + (& $exe --cmd "info-get $cle" 2>&1)).Trim()
        Ecrire "  guestinfo : $cle - vmtoolsd sort en $code : $detail"
        return ""
    }
    if (-not $valeur) { Ecrire "  guestinfo : $cle - lue, mais vide." }
    return $valeur
}

if (-not (AdresseUtilisable)) {
    Ecrire "Aucune adresse IPv4 utilisable - lecture de l'adressage fourni par l'hyperviseur."
    # VMware Tools demarre PENDANT que l'amorcage tourne deja. Constate le 21/08 :
    # deux lectures a 16:59 et 17:04 rendent vide, la meme commande tapee a la
    # main a 17:14 rend l'adresse. Une lecture unique condamnait donc la machine
    # pour de bon - rien ne la ramene jamais dans ce bloc.
    # On n'insiste QUE si vmtoolsd existe : ailleurs (Proxmox), attendre trois
    # minutes pour rien retarderait chaque deploiement sain.
    $cidr = ""
    if (-not (CheminVmtoolsd)) {
        Ecrire "  guestinfo : vmtoolsd absent - machine hors vSphere, poursuite en DHCP."
    } else {
        for ($essaiIp = 1; $essaiIp -le 18; $essaiIp++) {
            $cidr = InfoGet "guestinfo.osiris.ip"
            if ($cidr) {
                if ($essaiIp -gt 1) { Ecrire "  guestinfo : lue au bout de $($essaiIp * 10) s." }
                break
            }
            if ($essaiIp -lt 18) { Start-Sleep -Seconds 10 }
        }
    }
    # Formule POSITIVE volontairement : `-notmatch` alimente lui aussi $Matches,
    # mais la regle est assez subtile pour qu'une relecture s'y trompe, et un
    # $Matches vide donnerait ici une adresse vide posee sans erreur.
    if ($cidr -match '^([0-9]{1,3}(?:\.[0-9]{1,3}){3})/([0-9]{1,2})$') {
        $ip      = $Matches[1]
        $prefixe = [int] $Matches[2]
        # netsh veut un masque en notation pointee, pas une longueur de prefixe.
        $bits    = ("1" * $prefixe).PadRight(32, "0")
        $masque  = (0..3 | ForEach-Object { [Convert]::ToByte($bits.Substring($_ * 8, 8), 2) }) -join "."
        $gw      = InfoGet "guestinfo.osiris.gateway"
        $dns     = InfoGet "guestinfo.osiris.dns"
        $carte   = Get-NetAdapter -Physical -ErrorAction SilentlyContinue |
                       Where-Object { $_.Status -eq "Up" } | Select-Object -First 1
        if (-not $carte) {
            Ecrire "ERREUR : aucune carte reseau active - adressage impossible."
        } else {
            $nom = $carte.Name
            # netsh plutot que New-NetIPAddress : il REMPLACE la configuration au
            # lieu d'en empiler une par-dessus l'adresse d'auto-configuration, ce
            # qui evite toute une famille d'echecs "parametre invalide" (87).
            if ($gw) {
                netsh interface ipv4 set address name="$nom" static $ip $masque $gw | Out-Null
            } else {
                netsh interface ipv4 set address name="$nom" static $ip $masque | Out-Null
            }
            $rang = 1
            foreach ($serveur in ($dns -split "," | Where-Object { $_.Trim() })) {
                $serveur = $serveur.Trim()
                if ($rang -eq 1) {
                    netsh interface ipv4 set dnsservers name="$nom" static $serveur primary | Out-Null
                } else {
                    netsh interface ipv4 add dnsservers name="$nom" $serveur index=$rang | Out-Null
                }
                $rang++
            }
            Start-Sleep -Seconds 5
            if (AdresseUtilisable) {
                Ecrire "Adresse posee : $ip/$prefixe via $nom (passerelle ${gw}, DNS ${dns})"
            } else {
                Ecrire "AVERTISSEMENT : adresse $ip/$prefixe demandee mais toujours pas active."
            }
        }
    } else {
        Ecrire "Pas d'adressage exploitable (guestinfo.osiris.ip = '$cidr') - on poursuit en DHCP."
    }
}

# Cartes physiques uniquement : un adaptateur de bouclage, un pont Hyper-V ou une
# carte virtuelle ne correspond a aucune fiche OSIRIS.
function Macs {
    Get-NetAdapter -Physical -ErrorAction SilentlyContinue |
        Where-Object { $_.Status -eq "Up" } |
        ForEach-Object { $_.MacAddress -replace '[-:]', '' } |
        ForEach-Object { $_.ToLower() } |
        Where-Object { $_ -and $_ -ne "000000000000" }
}

$script = "$env:TEMP\osiris-firstboot.ps1"

# 30 tentatives x 10 s = 5 min : de quoi laisser le bail DHCP s'etablir, et
# couvrir le cas ou la VM demarre avant que sa fiche existe cote OSIRIS.
for ($essai = 1; $essai -le 30; $essai++) {
    $details = ""
    foreach ($mac in (Macs)) {
        $code = 0
        try {
            # -MaximumRedirection 0 : une 3xx doit se voir. Sans ca, une route
            # absente du frontal (qui redirige vers HTTPS) ressemblerait a une
            # fiche introuvable, et le journal accuserait la mauvaise cause -
            # exactement le piege tombe cote Linux le 05/08.
            $r = Invoke-WebRequest -Uri "$OsirisUrl/firstboot-windows/$mac" `
                                   -OutFile $script -PassThru -UseBasicParsing `
                                   -MaximumRedirection 0 -TimeoutSec 20
            $code = [int] $r.StatusCode
        } catch {
            if ($_.Exception.Response) {
                $code = [int] $_.Exception.Response.StatusCode
            } else {
                $code = 0
            }
        }

        if ($code -eq 200 -and (Test-Path $script) -and (Get-Item $script).Length -gt 0) {
            Ecrire "Fiche trouvee pour la MAC $mac - execution du premier demarrage."
            New-Item -ItemType File -Path $verrou -Force | Out-Null
            try {
                Invoke-WebRequest -Uri "$OsirisUrl/machines/$mac/status?status=deploying" `
                                  -Method POST -UseBasicParsing -TimeoutSec 15 | Out-Null
            } catch {
                Ecrire "AVERTISSEMENT : statut 'deploying' non poste - $_"
            }
            # Le firstboot se supprime puis redemarre la machine : rien apres.
            & powershell -ExecutionPolicy Bypass -File $script
            exit 0
        }

        switch ($code) {
            0       { $indice = "serveur injoignable" }
            404     { $indice = "pas de fiche pour cette MAC" }
            default {
                if ($code -ge 300 -and $code -lt 400) {
                    $indice = "REDIRECTION : /firstboot-windows/* n'est pas servi en clair (matcher du frontal ?)"
                } else {
                    $indice = "reponse inattendue"
                }
            }
        }
        $details += " $mac->HTTP $code ($indice);"
        Remove-Item $script -Force -ErrorAction SilentlyContinue
    }
    Ecrire "Tentative $essai/30 :$details nouvel essai dans 10 s."
    Start-Sleep -Seconds 10
}

# On sort SANS supprimer la tache planifiee : seul le firstboot la retire, une
# fois qu'il a reellement tourne. Une VM demarree trop tot retentera donc au
# prochain demarrage au lieu de rester orpheline pour toujours.
Ecrire "Abandon apres 5 minutes - nouvelle tentative au prochain demarrage."
exit 0
'@

Set-Content -Path "$dossierProg\osiris-bootstrap.ps1" -Value $amorcage -Encoding UTF8
Write-Host "[OSIRIS] Amorcage installe : $dossierProg\osiris-bootstrap.ps1"

# ── Tache planifiee de secours ───────────────────────────────────────────────
# La session automatique du fichier de reponses ne se declenche QU'UNE FOIS. Un
# clone demarre pendant une coupure reseau serait alors orphelin pour toujours,
# sans aucun moyen de se rattraper - c'est precisement ce que la conception
# Linux evite. Cette tache rejoue l'amorcage a chaque demarrage tant que le
# firstboot n'a pas tourne ; c'est lui qui la retire ensuite.
# Retard de 5 min : le chemin normal (session automatique) a ainsi le temps
# d'aboutir, et le verrou empeche de toute facon les deux de se marcher dessus.
$action = New-ScheduledTaskAction -Execute "powershell.exe" `
    -Argument '-ExecutionPolicy Bypass -WindowStyle Hidden -File "C:\Program Files\OSIRIS\osiris-bootstrap.ps1"'
$declencheur = New-ScheduledTaskTrigger -AtStartup
$declencheur.Delay = "PT5M"
$principal = New-ScheduledTaskPrincipal -UserId "SYSTEM" -RunLevel Highest
$reglages = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries `
    -DontStopIfGoingOnBatteries -ExecutionTimeLimit ([TimeSpan]::Zero)

Register-ScheduledTask -TaskName "OsirisFirstBoot" -Action $action `
    -Trigger $declencheur -Principal $principal -Settings $reglages -Force | Out-Null
Write-Host "[OSIRIS] Tache de secours 'OsirisFirstBoot' enregistree."

# ── Scellement ───────────────────────────────────────────────────────────────
if (-not $Seal) {
    Write-Host ""
    Write-Host "[OSIRIS] Amorcage en place. Avant de convertir cette VM en template :"
    Write-Host "         & ([scriptblock]::Create((irm $OsirisUrl/bootstrap/windows))) -Seal"
    return
}

Write-Host "[OSIRIS] Recuperation du fichier de reponses generique..."
$uriReponses = "$OsirisUrl/bootstrap/windows/unattend.xml"
if ($ProductKey) {
    $uriReponses += "?product_key=" + [uri]::EscapeDataString($ProductKey)
    Write-Host "[OSIRIS] Clef de produit fournie : elle sera gravee dans le gabarit."
} else {
    Write-Host "[OSIRIS] AVERTISSEMENT : aucune clef de produit."
    Write-Host "         Sur un support SOUS LICENCE, l'OOBE de chaque clone s'arretera"
    Write-Host "         sur « entrez votre cle de produit » et attendra un humain."
    Write-Host "         Utiliser la KMS client setup key (GVLK) de l'edition installee :"
    Write-Host "           -ProductKey XXXXX-XXXXX-XXXXX-XXXXX-XXXXX"
}
Invoke-WebRequest -Uri $uriReponses `
                  -OutFile $reponses -UseBasicParsing -TimeoutSec 30
Write-Host "[OSIRIS] Fichier de reponses ecrit : $reponses"

# Journaux de l'installation : ils ne doivent pas se retrouver dans tous les clones.
Remove-Item "C:\osiris-bootstrap.log", "C:\osiris-firstboot.log" `
            -Force -ErrorAction SilentlyContinue
Remove-Item "$dossierData\firstboot-en-cours.marker" -Force -ErrorAction SilentlyContinue

Write-Host ""
Write-Host "[OSIRIS] Lancement de sysprep. La VM va s'eteindre."
Write-Host "         NE PAS la redemarrer ensuite : la rallumer consommerait le"
Write-Host "         passage OOBE, et le template naitrait deja personnalise."
Write-Host "         Convertir en modele SANS rallumer :"
Write-Host "           Proxmox : qm template <vmid>"
Write-Host "           vSphere : clic droit sur la VM > Modele > Convertir en modele"
Start-Sleep -Seconds 3

# Sur un Windows 64 bits, une console PowerShell 32 bits voit C:\Windows\System32
# REDIRIGE vers SysWOW64, qui ne contient aucun dossier Sysprep : la commande
# echoue en "n'est pas reconnu", ce qui ressemble a une installation abimee alors
# que le fichier est bien la. `Sysnative` est l'echappatoire prevue par Windows
# pour retrouver le vrai System32 depuis un processus 32 bits.
# Constate le 21/08 : scellement lance depuis "Windows PowerShell (x86)".
$dossierSysteme = "$env:SystemRoot\System32"
if ([Environment]::Is64BitOperatingSystem -and -not [Environment]::Is64BitProcess) {
    $dossierSysteme = "$env:SystemRoot\Sysnative"
    Write-Host "[OSIRIS] Console 32 bits detectee - sysprep atteint via Sysnative."
}
& "$dossierSysteme\Sysprep\sysprep.exe" /generalize /oobe /shutdown /unattend:$reponses
