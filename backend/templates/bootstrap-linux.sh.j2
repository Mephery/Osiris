#!/bin/bash
# ==============================================================================
# OSIRIS - Installation du mecanisme d'amorcage generique (Linux)
#
# A executer UNE SEULE FOIS, en root, sur la VM qui servira de template :
#     curl -sf {{ osiris_url }}/bootstrap/linux | bash
#     curl -sf {{ osiris_url }}/bootstrap/linux | bash -s -- --seal   # + scellement
#
# Ce qu'il installe ne contient AUCUN identifiant et AUCUNE logique metier :
# juste « lis ta MAC, demande ton script a OSIRIS, execute-le ». Tout le reste
# (profil, applications, jonction au domaine, supervision) est decide par OSIRIS
# au demarrage de chaque clone. Consequence : on ne refabrique PAS le template
# quand un profil change - seulement si ce mecanisme-ci evolue, c'est-a-dire
# quasiment jamais.
# ==============================================================================
set -euo pipefail

OSIRIS_URL="{{ osiris_url }}"
SEAL=0
for arg in "$@"; do
    case "$arg" in
        --seal) SEAL=1 ;;
        --url=*) OSIRIS_URL="${arg#--url=}" ;;
        *) echo "Argument inconnu : $arg" >&2; exit 2 ;;
    esac
done

[ "$(id -u)" -eq 0 ] || { echo "A executer en root." >&2; exit 1; }

echo "[OSIRIS] Serveur : $OSIRIS_URL"

mkdir -p /etc/osiris
# Seule donnee propre a l'installation : l'URL d'OSIRIS. Ce n'est pas un secret.
printf 'OSIRIS_URL=%s\n' "$OSIRIS_URL" > /etc/osiris/bootstrap.conf
chmod 644 /etc/osiris/bootstrap.conf

cat > /usr/local/sbin/osiris-bootstrap.sh << 'OSIRIS_BOOTSTRAP_EOF'
#!/bin/bash
# OSIRIS - Amorcage du premier demarrage. Generique : ce fichier est identique
# sur toutes les machines, il ne contient ni secret ni configuration.
LOG=/var/log/osiris-bootstrap.log
exec >> "$LOG" 2>&1
# Le fuseau fait partie de l'horodatage : une image cloud tourne en UTC alors que
# l'exploitant lit ses journaux en heure locale. Sans le suffixe, on compare deux
# horloges sans le savoir — ce qui est arrive le 2026-08-14, avec deux heures
# d'ecart et un diagnostic fausse.
ts() { date '+%Y-%m-%d %H:%M:%S %Z'; }

OSIRIS_URL=""
[ -r /etc/osiris/bootstrap.conf ] && . /etc/osiris/bootstrap.conf
if [ -z "$OSIRIS_URL" ]; then
    echo "[$(ts)] Aucune URL OSIRIS dans /etc/osiris/bootstrap.conf - abandon."
    exit 1
fi

# Cartes physiques uniquement : un pont, un veth ou une interface docker n'a pas
# de lien ../device et ne correspond a aucune fiche OSIRIS.
macs() {
    local iface mac
    for iface in /sys/class/net/*; do
        [ -e "$iface/device" ] || continue
        mac=$(tr -d ':' < "$iface/address" 2>/dev/null | tr 'A-Z' 'a-z')
        [ -n "$mac" ] && [ "$mac" != "000000000000" ] && echo "$mac"
    done
}

# ── Adressage d'un clone nu ──────────────────────────────────────────────────
# Un clone de gabarit demarre avec le reseau du gabarit, c'est-a-dire DHCP. Sur
# un VLAN serveur qui n'en a pas, il n'obtient aucune adresse, ne joint personne,
# et sa fiche reste « en attente » sans une ligne de journal : la machine qui
# devrait signaler le probleme est justement celle qui ne peut pas parler.
#
# OSIRIS ecrit donc l'adressage dans la configuration de la VM (guestinfo), que
# VMware Tools lit SANS passer par le reseau. Cote Windows ce chemin existe
# depuis le 21/08 ; cote Linux il n'avait jamais ete ecrit — les cles etaient
# posees et lues par PERSONNE. C'est ce trou-la que ce bloc ferme.
#
# Rien ici n'est propre a une machine : les valeurs viennent de la VM, le code
# est le meme partout. Et c'est le SEUL reseau que l'agent configure — le
# firstboot n'y touche pas, donc l'adresse doit etre posee pour de bon.

# Une adresse ROUTABLE sur une carte physique. 169.254.x n'en est pas une : c'est
# le symptome de l'echec DHCP qu'on vient corriger, et le prendre pour une
# adresse valide ferait renoncer l'agent juste avant de servir a quelque chose.
adresse_utilisable() {
    local iface nom
    for iface in /sys/class/net/*; do
        [ -e "$iface/device" ] || continue
        nom=${iface##*/}
        ip -4 -o addr show dev "$nom" scope global 2>/dev/null \
            | grep -v ' 169\.254\.' | grep -q . && return 0
    done
    return 1
}

premiere_carte() {
    local iface
    for iface in /sys/class/net/*; do
        [ -e "$iface/device" ] || continue
        echo "${iface##*/}"
        return 0
    done
}

# `$env:ProgramFiles` avait son equivalent ici : vmtoolsd n'est pas au meme
# endroit selon la distribution et le mode d'installation (paquet distribution
# ou open-vm-tools compile). Ne pas le trouver n'est PAS « pas de VMware ».
chemin_vmtoolsd() {
    local c
    for c in /usr/bin/vmtoolsd /usr/sbin/vmtoolsd /usr/local/bin/vmtoolsd; do
        [ -x "$c" ] && { echo "$c"; return 0; }
    done
    command -v vmtoolsd 2>/dev/null || true
}

# On juge sur la VALEUR, jamais sur le code de sortie. Meme lecon que cote
# Windows le 21/08 : un code de sortie absent ou non nul faisait jeter une
# valeur parfaitement bonne. Le code est un indice, la valeur est ce qu'on est
# venu chercher — et l'appelant verifie de toute facon qu'elle ressemble a une
# adresse.
info_get() {
    local exe="$1" cle="$2" sortie
    sortie=$("$exe" --cmd "info-get $cle" 2>&1) || true
    printf '%s' "$sortie" | tr -d '\r' | head -n1 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

# Ecrit l'adressage POUR DE BON. Le firstboot ne configure pas le reseau : une
# adresse seulement posee en memoire disparaitrait au premier redemarrage, et la
# machine retomberait muette apres avoir semble marcher — pire qu'un echec franc.
appliquer_adressage() {
    local ip="$1" gw="$2" dns="$3" carte="$4" fichier liste
    if command -v netplan >/dev/null 2>&1; then
        # Chemin surchargeable UNIQUEMENT pour que les tests puissent relire ce
        # qui a ete ecrit sans avoir les droits sur /etc. En production la
        # variable n'est jamais posee, et la valeur par defaut s'applique.
        fichier=${OSIRIS_NETPLAN:-/etc/netplan/60-osiris.yaml}
        {
            echo "network:"
            echo "  version: 2"
            echo "  ethernets:"
            echo "    $carte:"
            echo "      dhcp4: false"
            echo "      addresses: [$ip]"
            if [ -n "$gw" ]; then
                # `routes:` et non `gateway4:`, deprecie et ignore en silence par
                # les netplan recents — le genre de reglage qui ne produit ni
                # erreur ni route.
                echo "      routes:"
                echo "        - to: default"
                echo "          via: $gw"
            fi
            if [ -n "$dns" ]; then
                liste=$(printf '%s' "$dns" | sed 's/,/, /g')
                echo "      nameservers:"
                echo "        addresses: [$liste]"
            fi
        } > "$fichier"
        # netplan refuse de lire un fichier lisible par tous et le dit dans un
        # avertissement qu'on ne voit pas ici.
        chmod 600 "$fichier"
        if netplan apply >/dev/null 2>&1; then
            echo "[$(ts)] Adressage : $ip applique et ECRIT dans $fichier (carte $carte)."
            return 0
        fi
        echo "[$(ts)] Adressage : netplan a refuse $fichier - repli temporaire."
    else
        echo "[$(ts)] Adressage : netplan absent - repli temporaire."
    fi
    # Repli : la machine pourra finir son deploiement, mais l'adresse ne
    # survivra pas au redemarrage. On le DIT, au lieu de laisser croire.
    ip addr add "$ip" dev "$carte" 2>/dev/null || true
    ip link set "$carte" up 2>/dev/null || true
    [ -n "$gw" ] && ip route add default via "$gw" 2>/dev/null || true
    if [ -n "$dns" ]; then
        printf 'nameserver %s\n' $(printf '%s' "$dns" | tr ',' ' ') >> /etc/resolv.conf
    fi
    echo "[$(ts)] Adressage : $ip pose TEMPORAIREMENT sur $carte - ne survivra PAS au redemarrage."
}

if adresse_utilisable; then
    echo "[$(ts)] Adressage : une adresse routable est deja en place, rien a imposer."
else
    VMTOOLSD=$(chemin_vmtoolsd)
    if [ -z "$VMTOOLSD" ]; then
        # Proxmox, KVM nu, materiel physique : pas de canal guestinfo, et c'est
        # normal. Ne rien dire ici ferait chercher un bug la ou il n'y en a pas.
        echo "[$(ts)] Adressage : vmtoolsd introuvable (hyperviseur non VMware) - on garde le reseau du gabarit."
    else
        # VMware Tools demarre APRES nous : la lecture rend du vide pendant les
        # premieres minutes. Constate cote Windows le 21/08 — vide a 16:59, vide
        # a 17:04, et la valeur a 17:14 en tapant la meme commande a la main.
        ADR=""
        for essai in $(seq 1 18); do
            ADR=$(info_get "$VMTOOLSD" "guestinfo.osiris.ip")
            case "$ADR" in
                */*) break ;;
                *)   ADR="" ;;
            esac
            echo "[$(ts)] Adressage : guestinfo pas encore lisible ($essai/18) - nouvel essai dans 10 s."
            sleep 10
        done
        if [ -z "$ADR" ]; then
            # Cas parfaitement legitime : aucune adresse imposee, la machine est
            # censee faire du DHCP. On le distingue quand meme d'un echec de
            # lecture, parce que les deux se ressemblaient et que c'est ce qui a
            # coute une heure de console le 21/08.
            echo "[$(ts)] Adressage : aucune adresse dans guestinfo - la machine reste en DHCP."
        else
            GW=$(info_get "$VMTOOLSD" "guestinfo.osiris.gateway")
            DNS=$(info_get "$VMTOOLSD" "guestinfo.osiris.dns")
            CARTE=$(premiere_carte)
            if [ -z "$CARTE" ]; then
                echo "[$(ts)] Adressage : aucune carte physique trouvee - $ADR non applique."
            else
                echo "[$(ts)] Adressage : guestinfo donne ip=$ADR gw=${GW:-aucune} dns=${DNS:-aucun}"
                appliquer_adressage "$ADR" "$GW" "$DNS" "$CARTE"
            fi
        fi
    fi
fi

SCRIPT=/run/osiris-firstboot.sh
# 30 tentatives, de quoi laisser le bail DHCP s'etablir et couvrir le cas ou la
# VM demarre avant que sa fiche existe cote OSIRIS.
#
# La duree totale n'est PAS 5 minutes : quand OSIRIS est injoignable, chaque
# curl consomme ses 20 s de `--max-time` avant de rendre 000. Une tentative
# coute alors 30 s et non 10, soit un quart d'heure au total. C'est le pire cas,
# et c'est exactement celui qu'on rencontre quand un pare-feu jette les paquets.
for attempt in $(seq 1 30); do
    details=""
    for mac in $(macs); do
        # Pas de -f : on veut LIRE le code HTTP, pas seulement echouer dessus. Avec
        # -f, une 404 (fiche absente), une 308 (route non proxifiee) et un serveur
        # injoignable donnaient tous le meme silence, et le journal accusait
        # l'absence de fiche dans les trois cas. Diagnostic fausse pendant 5 min.
        code=$(curl -s -o "$SCRIPT" -w '%{http_code}' --max-time 20 \
               "$OSIRIS_URL/firstboot-linux/$mac" 2>/dev/null || echo 000)
        if [ "$code" = "200" ] && [ -s "$SCRIPT" ]; then
            echo "[$(ts)] Fiche trouvee pour la MAC $mac - execution du premier demarrage."
            curl -sf -X POST "$OSIRIS_URL/machines/$mac/status?status=deploying" --max-time 15 || true
            chmod +x "$SCRIPT"
            # PAS `exec`. Avec lui, le script de premier demarrage devient le
            # processus principal de l'unite, et SON code de sortie decide du
            # `Restart=on-failure` : un deploiement qui echoue en cours de route
            # relancerait alors le deploiement entier toutes les deux minutes,
            # indefiniment — reinstallation des paquets et jonction de domaine
            # comprises.
            #
            # L'agent n'a qu'une responsabilite : joindre OSIRIS et livrer le
            # script. Il a reussi a l'instant ou il l'a lance. Ce qui se passe
            # ensuite regarde le deploiement, qui rapporte lui-meme son echec a
            # OSIRIS — le reessai de l'unite ne doit couvrir QUE le cas « je n'ai
            # jamais pu joindre le serveur ».
            /bin/bash "$SCRIPT"
            exit 0
        fi
        case "$code" in
            000) indice="serveur injoignable" ;;
            404) indice="pas de fiche pour cette MAC" ;;
            30*) indice="REDIRECTION : $OSIRIS_URL/firstboot-linux/* n'est pas servi en clair (matcher du reverse proxy ?)" ;;
            *)   indice="reponse inattendue" ;;
        esac
        details="$details $mac->HTTP $code ($indice);"
        : > "$SCRIPT"
    done
    echo "[$(ts)] Tentative $attempt/30 :$details nouvel essai dans 10 s."
    sleep 10
done

# On sort SANS desactiver l'unite : le script de premier demarrage est le seul a
# le faire, une fois qu'il a reellement tourne.
#
# Et on sort en ERREUR. Rendre 0 ici disait « reussi » a systemd, qui affichait
# alors « active (exited) » : ni la supervision, ni `systemctl status`, ni la
# fiche OSIRIS ne pouvaient distinguer un deploiement termine d'un deploiement
# jamais commence. Une VM restait « en attente » sans que rien, nulle part,
# n'indique que plus personne n'appelait. Constate le 2026-08-14, ou seul un
# `systemctl restart` manuel a relance la machine.
#
# Le code non nul est aussi ce qui autorise le `Restart=on-failure` de l'unite :
# c'est lui qui transforme une fenetre unique en reessai perpetuel.
echo "[$(ts)] Abandon apres $attempt tentatives - l unite va reessayer."
exit 1
OSIRIS_BOOTSTRAP_EOF
chmod 755 /usr/local/sbin/osiris-bootstrap.sh

cat > /etc/systemd/system/osiris-firstboot.service << 'OSIRIS_UNIT_EOF'
[Unit]
Description=OSIRIS First Boot
After=network-online.target
Wants=network-online.target

[Service]
# `simple` et non `oneshot` : `Restart=` est refuse sur un oneshot, or c'est lui
# qui fait toute la difference ci-dessous.
Type=simple
ExecStart=/usr/local/sbin/osiris-bootstrap.sh
RemainAfterExit=yes
# Un premier demarrage installe des paquets et joint un domaine : il depasse
# largement les 90 s du delai par defaut, qui tuerait le script en plein milieu.
TimeoutStartSec=infinity

# Le coeur du correctif. Sans ces deux lignes, une VM demarree avant que son
# chemin reseau soit ouvert renoncait au bout d'un quart d'heure et n'essayait
# plus jamais avant un redemarrage : elle restait « en attente » pour toujours,
# en silence. Elle retente desormais toutes les 2 minutes, indefiniment.
#
# Ce n'est pas une boucle infinie couteuse : chaque tentative est un GET qui
# echoue en quelques secondes, et le script se desactive de lui-meme des qu'il
# reussit. Une VM qui n'aurait jamais de fiche cote OSIRIS ne fait donc qu'un
# appel toutes les deux minutes, ce qu'aucun reseau ne remarque.
Restart=on-failure
RestartSec=120

[Install]
WantedBy=multi-user.target
OSIRIS_UNIT_EOF

systemctl daemon-reload
systemctl enable osiris-firstboot.service > /dev/null
echo "[OSIRIS] Unite osiris-firstboot.service installee et activee."

if [ "$SEAL" -eq 1 ]; then
    echo "[OSIRIS] Scellement du template..."
    command -v cloud-init > /dev/null && cloud-init clean --logs --seed || true
    # machine-id identique sur tous les clones = meme DUID DHCP = baux qui se
    # volent l'un l'autre. Il doit etre vide pour etre regenere au demarrage.
    : > /etc/machine-id
    rm -f /var/lib/dbus/machine-id
    rm -f /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub
    rm -f /var/log/osiris-bootstrap.log /var/log/osiris-firstboot.log
    echo "[OSIRIS] Template scelle. Eteindre la VM, puis la convertir en modele :"
    echo "[OSIRIS]   Proxmox : qm template <vmid>"
    echo "[OSIRIS]   vSphere : clic droit sur la VM > Modele > Convertir en modele"
else
    echo "[OSIRIS] Avant de convertir cette VM en template, relancer avec --seal"
    echo "         (remise a zero de machine-id, des cles SSH et de cloud-init)."
fi
