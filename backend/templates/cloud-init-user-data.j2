#cloud-config
# OSIRIS - Cloud-init user-data genere automatiquement pour {{ machine.hostname }}
hostname: {{ machine.hostname }}
manage_etc_hosts: true

users:
  - name: {{ profile.default_user }}
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    passwd: '{{ machine.password_hash }}'
{% if profile.ssh_authorized_keys %}
    ssh_authorized_keys:
{% for key in profile.ssh_authorized_keys.strip().splitlines() %}
{% if key.strip() %}
      - "{{ key.strip() }}"
{% endif %}
{% endfor %}
{% endif %}

chpasswd:
  expire: false

{% if profile.ntp_servers %}
# Serveurs de temps, poses par cloud-init lui-meme : la machine est a l'heure
# avant meme le premier demarrage d'OSIRIS, et elle le reste si elle ne le joint
# jamais. Ce n'est pas du confort : Kerberos refuse toute authentification
# au-dela de cinq minutes d'ecart, et une machine qui derive perd sa jonction au
# domaine sans qu'aucun message ne parle d'horloge. Les pools publics de l'image
# cloud, eux, sont injoignables des que le reseau ne sort pas librement.
ntp:
  enabled: true
  servers:
{% for serveur in profile.ntp_servers %}
    - {{ serveur }}
{% endfor %}
{% endif %}

{% if profile.apt_mirror or profile.apt_proxy %}
# Depots apt. Pose AVANT `packages:` ci-dessous, sans quoi l'installation
# viserait encore le miroir d'origine de l'image.
apt:
{% if profile.apt_proxy %}
  proxy: {{ profile.apt_proxy }}
{% endif %}
{% if profile.apt_mirror %}
  primary:
    - arches: [default]
      uri: {{ profile.apt_mirror }}
  security:
    - arches: [default]
      uri: {{ profile.apt_mirror }}
{% endif %}
{% endif %}

package_update: true
package_upgrade: false

{% if linux_apps %}
packages:
{% for app in linux_apps %}
  - {{ app.apt_package }}
{% endfor %}
{% endif %}

{% if firstboot_b64 %}
# Le script voyage avec la VM plutot que d'etre telecharge au demarrage : une
# machine qui ne joint pas OSIRIS se configure quand meme entierement, et seul
# son compte rendu se perd. Encode en base64 pour ne pas confier 300 lignes de
# bash a l'indentation du YAML.
write_files:
  - path: /usr/local/bin/osiris-firstboot.sh
    permissions: '0755'
    encoding: b64
    content: {{ firstboot_b64 }}
{% endif %}

runcmd:
  - curl -sf -m 15 -X POST '{{ osiris_url }}/machines/{{ mac }}/status?status=deploying' || true
{% if not firstboot_b64 %}
  - curl -sf -o /usr/local/bin/osiris-firstboot.sh '{{ osiris_url }}/firstboot-ubuntu/{{ mac }}'
  - chmod +x /usr/local/bin/osiris-firstboot.sh
{% endif %}
  - /usr/local/bin/osiris-firstboot.sh

final_message: "OSIRIS cloud-init termine pour {{ machine.hostname }}"
