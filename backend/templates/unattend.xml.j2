<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend"
          xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">

    <!-- ── Pass windowsPE : langue de l'installeur ──────────────────────── -->
    <settings pass="windowsPE">
        <component name="Microsoft-Windows-International-Core-WinPE"
                   processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35"
                   language="neutral" versionScope="nonSxS">
            <SetupUILanguage>
                <UILanguage>{{ profile.locale | replace('_','-') | truncate(5,true,'') }}</UILanguage>
            </SetupUILanguage>
            <InputLocale>{{ profile.locale | replace('_','-') | truncate(5,true,'') }}</InputLocale>
            <SystemLocale>{{ profile.locale | replace('_','-') | truncate(5,true,'') }}</SystemLocale>
            <UILanguage>{{ profile.locale | replace('_','-') | truncate(5,true,'') }}</UILanguage>
            <UserLocale>{{ profile.locale | replace('_','-') | truncate(5,true,'') }}</UserLocale>
        </component>
    </settings>

    <!-- ── Pass specialize : identité machine, locale OS, jonction domaine ─ -->
    <settings pass="specialize">
        <component name="Microsoft-Windows-Shell-Setup"
                   processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35"
                   language="neutral" versionScope="nonSxS">
            <ComputerName>{{ hostname }}</ComputerName>
            <RegisteredOwner>{{ client }}</RegisteredOwner>
            <TimeZone>{{ win_timezone }}</TimeZone>
        </component>
        <component name="Microsoft-Windows-International-Core"
                   processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35"
                   language="neutral" versionScope="nonSxS">
            <InputLocale>{{ profile.locale | replace('_','-') | truncate(5,true,'') }}</InputLocale>
            <SystemLocale>{{ profile.locale | replace('_','-') | truncate(5,true,'') }}</SystemLocale>
            <UserLocale>{{ profile.locale | replace('_','-') | truncate(5,true,'') }}</UserLocale>
        </component>
{# domain/user/password : echappement XML obligatoire (filtre |e) - un mot de passe
   contenant un simple "&" casse le parsing de l'unattend ("erreur interne lors du
   chargement du fichier de reponses"), constate en prod avec un mdp de jonction AD
   contenant "&". hostname/client/ou sont deja echappes cote Python (xml.sax.saxutils
   escape), mais profile_ctx ne l'est pas (il sert aussi au firstboot PowerShell, ou
   cet echappement XML serait au contraire faux). #}
{% if profile.join_domain and profile.domain_join_user and profile.domain_join_password %}
        <component name="Microsoft-Windows-UnattendedJoin"
                   processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35"
                   language="neutral" versionScope="nonSxS">
            <Identification>
                <JoinDomain>{{ profile.domain | e }}</JoinDomain>
{% if ou %}
                <MachineObjectOU>{{ ou }}</MachineObjectOU>
{% endif %}
                <Credentials>
                    <Domain>{{ profile.domain | e }}</Domain>
                    <Username>{{ profile.domain_join_user | e }}</Username>
                    <Password>{{ profile.domain_join_password | e }}</Password>
                </Credentials>
            </Identification>
        </component>
{% elif profile.join_domain %}
        <component name="Microsoft-Windows-UnattendedJoin"
                   processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35"
                   language="neutral" versionScope="nonSxS">
            <Identification>
                <JoinDomain>{{ profile.domain | e }}</JoinDomain>
{% if ou %}
                <MachineObjectOU>{{ ou }}</MachineObjectOU>
{% endif %}
            </Identification>
        </component>
{% endif %}
    </settings>

    <!-- ── Pass oobeSystem : skip OOBE, compte admin local ───────────────── -->
    <settings pass="oobeSystem">
        <component name="Microsoft-Windows-International-Core"
                   processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35"
                   language="neutral" versionScope="nonSxS">
            <InputLocale>{{ profile.locale | replace('_','-') | truncate(5,true,'') }}</InputLocale>
            <SystemLocale>{{ profile.locale | replace('_','-') | truncate(5,true,'') }}</SystemLocale>
            <UILanguage>{{ profile.locale | replace('_','-') | truncate(5,true,'') }}</UILanguage>
            <UserLocale>{{ profile.locale | replace('_','-') | truncate(5,true,'') }}</UserLocale>
        </component>
        <component name="Microsoft-Windows-Shell-Setup"
                   processorArchitecture="amd64"
                   publicKeyToken="31bf3856ad364e35"
                   language="neutral" versionScope="nonSxS">
            <OOBE>
                <HideEULAPage>true</HideEULAPage>
                <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
                <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
                <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
                <ProtectYourPC>3</ProtectYourPC>
            </OOBE>
{# Windows SERVER en experience utilisateur exige le mot de passe du compte
   Administrateur integre : sans <AdministratorPassword>, l'OOBE s'arrete sur
   « Personnaliser les parametres » et attend une saisie. La passe specialize
   est deja passee (la machine porte son nom), mais oobeSystem ne se termine
   jamais : ni compte local, ni ouverture de session automatique, donc AUCUN
   FirstLogonCommands et aucun firstboot. Constate sur SRV-WIN-TPL le
   2026-08-06 - la machine repondait en WinRM mais rejetait osiris-admin, qui
   n'avait jamais ete cree. Sans effet sur Windows 11, qui s'en passe. #}
            <UserAccounts>
                <AdministratorPassword>
                    <Value>{{ admin_password | e }}</Value>
                    <PlainText>true</PlainText>
                </AdministratorPassword>
                <LocalAccounts>
                    <LocalAccount wcm:action="add">
                        <Password>
                            <Value>{{ admin_password | e }}</Value>
                            <PlainText>true</PlainText>
                        </Password>
                        <DisplayName>Administrateur OSIRIS</DisplayName>
                        <Group>Administrators</Group>
                        <Name>osiris-admin</Name>
                    </LocalAccount>
                </LocalAccounts>
            </UserAccounts>
            <AutoLogon>
                <Password>
                    <Value>{{ admin_password | e }}</Value>
                    <PlainText>true</PlainText>
                </Password>
                <Enabled>true</Enabled>
                <LogonCount>1</LogonCount>
                <Username>osiris-admin</Username>
            </AutoLogon>
            <FirstLogonCommands>
                <SynchronousCommand wcm:action="add">
                    <Order>1</Order>
                    <Description>OSIRIS Post-Deploy</Description>
                    <CommandLine>cmd /c "if exist C:\osiris-firstboot.ps1 powershell -ExecutionPolicy Bypass -File C:\osiris-firstboot.ps1"</CommandLine>
                    <RequiresUserInput>false</RequiresUserInput>
                </SynchronousCommand>
            </FirstLogonCommands>
        </component>
    </settings>

</unattend>
