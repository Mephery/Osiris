# Autorise le compte de service OSIRIS (osiris) à exécuter uniquement les
# trois scripts dédiés à la gestion des tunnels VPN clients, sans mot de passe,
# et sans accès sudo générique.
#
# Installation :
#   sudo install -o root -g root -m 700 deploy/osiris-vpn-apply.sh   /usr/local/sbin/osiris-vpn-apply.sh
#   sudo install -o root -g root -m 700 deploy/osiris-vpn-disable.sh /usr/local/sbin/osiris-vpn-disable.sh, /usr/local/sbin/osiris-vpn-session.sh
#   sudo install -o root -g root -m 700 deploy/osiris-vpn-session.sh /usr/local/sbin/osiris-vpn-session.sh
#   sudo install -o root -g root -m 440 deploy/osiris-vpn.sudoers    /etc/sudoers.d/osiris-vpn
#   sudo visudo -c
osiris ALL=(root) NOPASSWD: /usr/local/sbin/osiris-vpn-apply.sh, /usr/local/sbin/osiris-vpn-disable.sh, /usr/local/sbin/osiris-vpn-session.sh
