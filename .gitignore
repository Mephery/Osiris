# ==========================================
#          OSIRIS - ROOT GITIGNORE          
# ==========================================

# SECURE & SECRETS
.env
*.env
.env.*
frontend/.env.*
# ...sauf les modèles sans valeurs, que `.env.*` excluait jusqu'ici — et que le
# README demande pourtant de copier à la première étape de l'installation.
!.env.example
!frontend/.env.example
*_backup.sql
*.dump
backend/backups/

# CONFIGS D'INFRA AVEC TOPOLOGIE RÉSEAU INTERNE (IP serveur, passerelle, DC AD,
# domaine AD). On versionne uniquement les templates *.example.
/Caddyfile
/dnsmasq.conf
deploy/.diskcheck.txt

# INSTALLEURS TIERS (binaires lourds + logiciels sous licence : Office, EDR…)
backend/static/installers/

# BASE DE DONNÉES
**/*.db
**/*.sqlite

# PYTHON
**/__pycache__/
**/*.pyc
**/*.pyo
**/venv/
.pytest_cache/

# NODE / FRONTEND
**/node_modules/
**/dist/
**/dist-ssr/

# BINAIRES LOURDS & APPLIANCE
**/*.iso
**/*.img
**/static/vmlinuz
**/static/initrd
**/static/wimboot
**/static/winpe/
**/static/ubuntu-*/
srv/tftp/ipxe.efi

# Environnement Python
**/venv/

# CERTIFICATS TLS (pour le jour où on ajoute HTTPS)
*.pem
*.key
*.crt
*.p12

# LOGS
*.log

# SYSTÈME & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/