[Unit]
Description=OSIRIS API (FastAPI + uvicorn)
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
User=humans
WorkingDirectory=/opt/osiris/backend
Environment=PATH=/opt/osiris/backend/venv/bin
# Les migrations AVANT l'API, et pas seulement pour la commodite : sans cette
# ligne, un deploiement qui ajoute une revision laisse la base en arriere, l'unite
# demarre quand meme et se declare « active (running) », /health repond 200 — il ne
# touche aucune table metier — et toute requete sur une machine tombe en
# UndefinedColumn. Une panne totale sous les apparences d'un demarrage reussi.
# Si Alembic echoue, l'API ne demarre pas : bien preferable a une API qui ment.
ExecStartPre=/opt/osiris/backend/venv/bin/alembic upgrade head
ExecStart=/opt/osiris/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
