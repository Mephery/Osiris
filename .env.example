# Modèle de configuration OSIRIS — copier puis remplir.
#
#   cp .env.example .env && chmod 640 .env      # déploiement Docker Compose
#   cp .env.example backend/.env && chmod 640 backend/.env   # installation native
#
# Le `chmod` n'est pas décoratif : avec un umask 022, le fichier naît en 644 et
# la clé Fernet, le secret JWT et les mots de passe deviennent lisibles par
# n'importe quel compte local. L'API et le worker tournant sous le même compte,
# 640 ne coûte rien.
#
# Ce fichier ne doit jamais contenir de vraie valeur : `.gitignore` exclut
# `*.env`, pas `.env.example`.

# ─── Base de données ─────────────────────────────────────────────────────────
# Obligatoires : leur absence lève une KeyError au démarrage, pas un défaut
# silencieux. DATABASE_URL, si elle est définie, prend le pas sur les quatre.
DB_USER=osiris
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=osiris
# DATABASE_URL=postgresql+psycopg://user:password@hote:5432/base

# ─── Secrets ─────────────────────────────────────────────────────────────────
# FERNET_KEY chiffre en base les mots de passe de jonction AD, les PIN BitLocker
# et les secrets TOTP. La perdre rend ces champs indéchiffrables ; la changer
# après coup aussi. Obligatoire.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Signe les jetons de session. Sans valeur, le code retombe sur une constante
# publique : tout le monde peut alors forger un jeton d'administrateur.
#   openssl rand -hex 32
JWT_SECRET=

# ─── Compte administrateur initial ───────────────────────────────────────────
# Créé au premier démarrage s'il n'existe pas. Le mot de passe par défaut du
# code est « changeme » — le renseigner ici, ou le changer dès la connexion.
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=

# ─── Réseau ──────────────────────────────────────────────────────────────────
# Adresse par laquelle les machines en cours de déploiement joignent OSIRIS.
# Elle part dans les scripts iPXE et les scripts de premier démarrage : une
# valeur fausse ne se voit qu'au poste qui ne démarre pas.
OSIRIS_BASE_URL=http://osiris.example.local:8000
OSIRIS_IP=
# Adresse HTTPS d'OSIRIS pour les machines, par son NOM : le certificat ne vaut
# que pour lui. Les scripts l'épinglent sur l'IP ci-dessus (`curl --resolve`), les
# VLAN clients ne résolvant pas forcément ce nom. Vide = les machines restent en
# HTTP. Le port 443 doit être ouvert depuis leurs réseaux jusqu'à OSIRIS.
OSIRIS_URL_HTTPS=

# Passerelle du LAN, pour les tunnels VPN clients. Déduite si elle est vide,
# mais mieux vaut la poser explicitement.
# OSIRIS_LAN_GATEWAY=

# Origines autorisées en CORS, séparées par des virgules. Vide = aucune.
ALLOWED_ORIGINS=https://osiris.example.local

# Clé publique SSH injectée dans les VM Linux déployées (cloud-init).
# OSIRIS_SSH_PUBKEY=

# ─── Services ────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── Supervision Zabbix (création d'hôte par l'API) ──────────────────────────
# Quand une machine passe « deployed », OSIRIS crée/maj son hôte dans Zabbix par
# l'API : bon groupe, modèle selon l'OS, bon proxy (résolu depuis le zabbix_server
# de l'orga/hyperviseur) et inventaire. Idempotent, jamais de suppression.
# Inactif tant que les TROIS premières ne sont pas renseignées.
#   - ZABBIX_API_URL : point d'entrée JSON-RPC COMPLET (…/api_jsonrpc.php)
#   - ZABBIX_API_TOKEN : jeton d'API (rôle en écriture sur le groupe ci-dessous)
#   - ZABBIX_DEPLOYED_GROUP : groupe d'accueil ; un sous-groupe « <groupe>/<org> »
#     est créé par organisation. Donner l'écriture au jeton SUR CE GROUPE SEUL
#     suffit — inutile d'ouvrir les groupes des autres clients.
# ZABBIX_API_URL=https://zabbix.example.local/api_jsonrpc.php
# ZABBIX_API_TOKEN=
# ZABBIX_DEPLOYED_GROUP=OSIRIS-deployes
# Sous-groupe « <groupe>/<org> » par organisation ? Défaut NON (groupe plat) : créer
# un sous-groupe exige `hostgroup.create`, souvent absent d'un jeton scopé étroit.
# ZABBIX_SUBGROUP_BY_ORG=false
# Pont IP -> NOM de proxy. Le `zabbix_server` d'une orga/hyperviseur est une IP (dont
# l'agent a besoin en `Server=`), mais l'API Zabbix identifie un proxy par son NOM et
# n'expose pas l'adresse d'un proxy actif. On ne crée l'hôte QUE si son proxy est
# résolu (sinon il serait muet) : renseigner ici chaque collecteur, « ip=nom,ip2=nom2 ».
# ZABBIX_PROXY_MAP=10.0.0.10=proxy-site-a,10.0.0.20=proxy-site-b
# Noms des modèles à attacher (le nom du modèle Linux varie selon l'âge de Zabbix).
# ZABBIX_TEMPLATE_LINUX=Linux by Zabbix agent active
# ZABBIX_TEMPLATE_WINDOWS=Windows by Zabbix agent active

# ─── Frontend (build Vite) ───────────────────────────────────────────────────
# Lue par build.sh, qui en dérive frontend/.env. URL à laquelle le navigateur
# joint l'API — pas l'adresse du réseau PXE ci-dessus.
VITE_API_URL=https://osiris.example.local

# ─── Chemins de données ──────────────────────────────────────────────────────
# Valeurs par défaut du code, à ne changer que si le stockage est ailleurs.
# WIN_SHARE_PATH=/srv/data/windows
# WINPE_DRIVERS_PATH=/srv/data/windows/winpe-drivers

# (WINDOWS_TEMPLATE_ADMIN_PASSWORD n'existe plus : chaque installation Windows
# reçoit un mot de passe aléatoire, conservé chiffré dans la fiche de la machine.)
